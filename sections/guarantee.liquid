{% stylesheet %}
/* ============================================================
   smg-guarantee  —  Shuffle Mode Guarantee / Trust section
   OS 2.0 | prefix: smg- | no external assets
   ============================================================ */

.smg-guarantee {
  --smg-bg:       var(--color-bone);
  --smg-fg:       var(--color-ink);
  --smg-sub:      var(--color-stone);
  --smg-accent:   var(--color-ember);
  --smg-line-c:   var(--color-line);
  --smg-card-bg:  transparent;
  --smg-icon-fg:  #fff;
  background: var(--smg-bg);
  color: var(--smg-fg);
  padding: clamp(4rem, 9vw, 7.5rem) 0;
}

/* ── Background variants ────────────────────────────────── */
.smg-guarantee--sand {
  --smg-bg:      var(--color-sand);
  --smg-line-c:  rgba(22,19,15,.12);
}

.smg-guarantee--ink {
  --smg-bg:      var(--color-ink);
  --smg-fg:      var(--color-bone);
  --smg-sub:     var(--color-sand);
  --smg-line-c:  rgba(246,242,234,.1);
  --smg-card-bg: rgba(246,242,234,.04);
}

/* ── Layout ─────────────────────────────────────────────── */
.smg-guarantee__inner {
  max-width: var(--page-width, 1440px);
  margin: 0 auto;
  padding: 0 clamp(1.5rem, 4vw, 4rem);
}

/* ── Header ─────────────────────────────────────────────── */
.smg-guarantee__header {
  text-align: center;
  margin-bottom: clamp(2.5rem, 5vw, 4rem);
}

.smg-guarantee__eyebrow {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--smg-accent);
  margin: 0 0 0.875rem;
}

.smg-guarantee__heading {
  font-family: var(--font-display);
  font-size: clamp(2rem, 3.5vw, 3rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.12;
  margin: 0 0 1rem;
  color: var(--smg-fg);
}

.smg-guarantee__subcopy {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  line-height: 1.7;
  color: var(--smg-sub);
  margin: 0 auto;
  max-width: 48ch;
}

/* ── Cards grid ─────────────────────────────────────────── */
.smg-guarantee__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1px;
  background: var(--smg-line-c);
  border: 1px solid var(--smg-line-c);
}

@media (min-width: 600px) {
  .smg-guarantee__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .smg-guarantee__grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* ── Single card ────────────────────────────────────────── */
.smg-guarantee__card {
  background: var(--smg-bg);
  padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 2.5vw, 2rem);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 1rem;
  transition: background 0.25s ease;
}

@media (prefers-reduced-motion: reduce) {
  .smg-guarantee__card {
    transition: none;
  }
}

.smg-guarantee--bone .smg-guarantee__card:hover,
.smg-guarantee--sand .smg-guarantee__card:hover {
  background: rgba(22,19,15,.035);
}

.smg-guarantee--ink .smg-guarantee__card:hover {
  background: rgba(246,242,234,.07);
}

/* ── Icon circle ────────────────────────────────────────── */
.smg-guarantee__icon-circle {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  background: var(--smg-accent);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.smg-guarantee__icon-circle svg {
  width: 1.25rem;
  height: 1.25rem;
  fill: none;
  stroke: var(--smg-icon-fg);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Glyph fallback */
.smg-guarantee__icon-glyph {
  font-size: 1.1rem;
  line-height: 1;
  color: var(--smg-icon-fg);
  user-select: none;
}

/* ── Card text ──────────────────────────────────────────── */
.smg-guarantee__card-title {
  font-family: var(--font-display);
  font-size: 1.0625rem;
  font-weight: 400;
  font-style: italic;
  line-height: 1.25;
  margin: 0;
  color: var(--smg-fg);
}

.smg-guarantee__card-text {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  line-height: 1.7;
  color: var(--smg-sub);
  margin: 0;
}

/* ── Payment row ────────────────────────────────────────── */
.smg-guarantee__payment {
  margin-top: clamp(2.5rem, 4vw, 3.5rem);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.6rem 1.25rem;
}

.smg-guarantee__payment-lock {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--smg-sub);
}

.smg-guarantee__payment-lock svg {
  width: 0.875rem;
  height: 0.875rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
}

.smg-guarantee__payment-divider {
  width: 1px;
  height: 1.1em;
  background: var(--smg-line-c);
  flex-shrink: 0;
}

.smg-guarantee__payment-methods {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.3rem 0.875rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.smg-guarantee__payment-method {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--smg-sub);
  opacity: 0.7;
  white-space: nowrap;
}
{% endstylesheet %}

{%- liquid
  assign bg = section.settings.background | default: 'bone'
  assign show_payment = section.settings.show_payment
-%}

<section
  class="smg-guarantee smg-guarantee--{{ bg }}"
  id="smg-guarantee-{{ section.id }}"
  aria-label="{{ section.settings.heading | default: 'Shop with confidence' | escape }}"
>
  <div class="smg-guarantee__inner">

    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.subcopy != blank -%}
      <header class="smg-guarantee__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="smg-guarantee__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="smg-guarantee__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subcopy != blank -%}
          <p class="smg-guarantee__subcopy">{{ section.settings.subcopy | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="smg-guarantee__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'guarantee' -%}
            {%- liquid
              assign icon_key = block.settings.icon | default: 'shield'
            -%}
            <article class="smg-guarantee__card" role="listitem" {{ block.shopify_attributes }}>

              <div class="smg-guarantee__icon-circle" aria-hidden="true">
                {%- case icon_key -%}
                  {%- when 'shield' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M12 2 L20 6 L20 12 C20 16.4 16.5 20.2 12 22 C7.5 20.2 4 16.4 4 12 L4 6 Z"/>
                      <polyline points="9 12 11 14 15 10"/>
                    </svg>
                  {%- when 'return' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <polyline points="1 4 1 10 7 10"/>
                      <path d="M3.51 15a9 9 0 1 0 .49-3.36"/>
                    </svg>
                  {%- when 'truck' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <rect x="1" y="3" width="15" height="13" rx="1"/>
                      <path d="M16 8 L20 8 L23 11 L23 16 L16 16 Z"/>
                      <circle cx="5.5" cy="18.5" r="2.5"/>
                      <circle cx="18.5" cy="18.5" r="2.5"/>
                    </svg>
                  {%- when 'needle' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                    </svg>
                  {%- when 'star' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                    </svg>
                  {%- when 'lock' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                      <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    </svg>
                  {%- when 'leaf' -%}
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M2 22 L22 2"/>
                      <path d="M6.5 17.5 C2 13 4 4 22 2 C20 20 11 22 6.5 17.5Z"/>
                    </svg>
                  {%- else -%}
                    {%- if block.settings.glyph != blank -%}
                      <span class="smg-guarantee__icon-glyph">{{ block.settings.glyph | escape }}</span>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M12 2 L20 6 L20 12 C20 16.4 16.5 20.2 12 22 C7.5 20.2 4 16.4 4 12 L4 6 Z"/>
                        <polyline points="9 12 11 14 15 10"/>
                      </svg>
                    {%- endif -%}
                {%- endcase -%}
              </div>

              {%- if block.settings.title != blank -%}
                <h3 class="smg-guarantee__card-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <p class="smg-guarantee__card-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}

            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if show_payment -%}
      <div class="smg-guarantee__payment" aria-label="Accepted payment methods">
        <div class="smg-guarantee__payment-lock">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          <span>Secure checkout</span>
        </div>
        <div class="smg-guarantee__payment-divider" aria-hidden="true"></div>
        <ul class="smg-guarantee__payment-methods">
          <li class="smg-guarantee__payment-method">Visa</li>
          <li class="smg-guarantee__payment-method" aria-label="Mastercard">MC</li>
          <li class="smg-guarantee__payment-method">Amex</li>
          <li class="smg-guarantee__payment-method">Apple Pay</li>
          <li class="smg-guarantee__payment-method">Shop Pay</li>
          <li class="smg-guarantee__payment-method">PayPal</li>
        </ul>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "tag": "section",
  "class": "smg-section-guarantee",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Shuffle Mode promise"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop with confidence"
    },
    {
      "type": "textarea",
      "id": "subcopy",
      "label": "Subcopy",
      "default": "Every order is backed by our full promise — from checkout to your closet.",
      "info": "Short reassurance line below the heading. Optional."
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "bone", "label": "Bone" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink",  "label": "Ink (dark)" }
      ],
      "default": "bone"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show payment methods",
      "default": true,
      "info": "Displays accepted payment method wordmarks and a secure checkout badge."
    }
  ],
  "blocks": [
    {
      "type": "guarantee",
      "name": "Guarantee card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield",  "label": "Shield (secure)" },
            { "value": "return",  "label": "Return arrow" },
            { "value": "truck",   "label": "Truck (shipping)" },
            { "value": "needle",  "label": "Heart (made with love)" },
            { "value": "leaf",    "label": "Leaf" },
            { "value": "star",    "label": "Star" },
            { "value": "lock",    "label": "Lock" },
            { "value": "glyph",   "label": "Custom glyph (see below)" }
          ],
          "default": "shield",
          "info": "Choose an inline SVG icon for this card."
        },
        {
          "type": "text",
          "id": "glyph",
          "label": "Custom glyph / symbol",
          "placeholder": "✦",
          "info": "Only used when Icon is set to \"Custom glyph\"."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure checkout"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Reassurance line",
          "default": "256-bit encrypted. Your details are never shared."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guarantee",
      "settings": {
        "eyebrow": "The Shuffle Mode promise",
        "heading": "Shop with confidence",
        "subcopy": "Every order is backed by our full promise — from checkout to your closet.",
        "background": "bone",
        "show_payment": true
      },
      "blocks": [
        {
          "type": "guarantee",
          "settings": {
            "icon": "shield",
            "title": "Secure checkout",
            "text": "256-bit encrypted. Your details are never shared."
          }
        },
        {
          "type": "guarantee",
          "settings": {
            "icon": "return",
            "title": "Easy 30-day returns",
            "text": "Changed your mind? Send it back, hassle-free."
          }
        },
        {
          "type": "guarantee",
          "settings": {
            "icon": "truck",
            "title": "Tracked U.S. shipping",
            "text": "Ships from the USA with tracking on every order."
          }
        },
        {
          "type": "guarantee",
          "settings": {
            "icon": "needle",
            "title": "Real small-batch fashion",
            "text": "Designed in Boston. No dropshipping, ever."
          }
        }
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}
