{% stylesheet %}
/* ── Complete-the-look: small-phone 480px ───────────────── */
@media (max-width: 480px) {
  /* Items row scrolls horizontally — tiles remain tappable */
  .ctl__items {
    scroll-padding-inline: 1rem;
    padding-inline: 0.25rem;
    /* Prevent row from exceeding viewport */
    max-width: 100%;
  }

  .ctl__item {
    width: clamp(130px, 38vw, 170px);
    /* flex children must not collapse below min-content */
    min-width: 0;
  }

  /* Main (hero) piece can be slightly wider */
  .ctl__item--main {
    width: clamp(140px, 42vw, 175px);
  }

  /* Footer: stack total + CTA full-width ≥44px */
  .ctl__foot {
    flex-direction: column;
    align-items: stretch;
  }

  .ctl__total {
    text-align: center;
  }

  .ctl__foot .btn {
    width: 100%;
    min-height: 44px;
    justify-content: center;
  }

  /* Checkbox tap target */
  .ctl__check {
    width: 2rem;
    height: 2rem;
  }

  .ctl__check input {
    width: 1.15rem;
    height: 1.15rem;
  }

  /* Variant select */
  .ctl__variant {
    min-height: 36px;
    font-size: 0.8125rem;
  }

  /* Product names wrap, don't overflow */
  .ctl__name {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
}

/* ── Complete-the-look: tiny-phone 380px ────────────────── */
@media (max-width: 380px) {
  .ctl__item {
    width: clamp(118px, 36vw, 145px);
    min-width: 0;
  }

  .ctl__item--main {
    width: clamp(128px, 40vw, 155px);
  }

  .ctl__plus {
    font-size: 1.1rem;
    padding-inline: 0.1rem;
  }

  .ctl__total-value {
    font-size: 1.35rem;
  }

  .ctl__name {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
}
{% endstylesheet %}

{%- comment -%}
  Complete the look — bundle the current product with complementary pieces and
  add them all to the bag in one click. Source order:
  1) product metafield `custom.complementary` (a product-list reference)
  2) fallback: other products in the product's first collection
{%- endcomment -%}
{%- liquid
  assign complementary = product.metafields.custom.complementary.value
  if complementary == blank
    assign rel = product.collections.first
    assign complementary = rel.products
  endif
-%}

{%- if product.available and complementary.size > 0 -%}
  <section class="ctl section" data-bundle data-include-main aria-label="Complete the look">
    <div class="container">
      <div class="section__head reveal" style="margin-bottom:1.75rem;">
        <div>
          <span class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</span>
          <h2 class="section__title">{{ section.settings.heading }}</h2>
        </div>
        <span class="card__cat">Build the full look in one tap</span>
      </div>

      <div class="ctl__items">
        <div class="ctl__item ctl__item--main">
          <div class="ctl__media editorial-frame">
            {%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}">{%- endif -%}
          </div>
          <span class="ctl__tag">This piece</span>
          <span class="ctl__name">{{ product.title }}</span>
          <span class="ctl__price">{{ product.price | money }}</span>
        </div>

        {%- assign added = 0 -%}
        {%- for item in complementary -%}
          {%- if item.id != product.id and item.available and added < section.settings.max_items -%}
            <span class="ctl__plus" aria-hidden="true">+</span>
            {% render 'bundle-item', item: item %}
            {%- assign added = added | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="ctl__foot">
        <div class="ctl__total">
          <span class="eyebrow">Total for the look</span>
          <span class="ctl__total-value" data-bundle-total data-main-price="{{ product.price }}"></span>
        </div>
        <button type="button" class="btn btn--primary btn--lg" data-bundle-add>Add the look to bag</button>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Complete the look",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Styled together" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "range", "id": "max_items", "min": 1, "max": 4, "step": 1, "label": "Complementary pieces", "default": 3 }
  ]
}
{% endschema %}
