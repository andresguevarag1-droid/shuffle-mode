<header class="header">
  <nav class="container header__bar" aria-label="Primary">
    <a href="{{ routes.root_url }}" class="header__logo">
      {{ section.settings.logo_text | default: shop.name }}<span class="dot">.</span>
    </a>

    {%- if section.settings.menu != blank -%}
      <ul class="header__nav">
        {%- for link in section.settings.menu.links -%}
          <li>
            <a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="header__actions">
      {%- if section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn--primary" style="padding:0.5rem 1.25rem;font-size:0.85rem;">
          {{ section.settings.cta_label | default: 'Get on the list' }}
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="icon-btn cart-count" aria-label="Cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M6 7h12l-1 13H7L6 7Z" /><path d="M9 7a3 3 0 0 1 6 0" />
        </svg>
        <span class="cart-count__badge" data-cart-count>{{ cart.item_count }}</span>
      </a>

      <button class="icon-btn header__menu-toggle" data-menu-toggle aria-expanded="false" aria-label="Menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  {%- if section.settings.menu != blank -%}
    <div class="header__menu" data-menu hidden>
      <ul class="container">
        {%- for link in section.settings.menu.links -%}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Shuffle Mode" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Get on the list" },
    { "type": "url", "id": "cta_url", "label": "CTA link" }
  ]
}
{% endschema %}
