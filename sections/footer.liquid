<footer class="footer">
  <div class="container footer__grid">
    <div>
      <p class="header__logo" style="font-size:1.5rem;">
        {{ section.settings.brand | default: shop.name }}<span class="dot" style="color:#e98e6f;">.</span>
      </p>
      <p style="margin-top:1rem;max-width:20rem;color:rgba(251,249,244,0.7);">
        {{ section.settings.blurb }}
      </p>
    </div>

    <div class="footer__cols">
      {%- for block in section.blocks -%}
        <div {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          {%- if block.settings.menu != blank -%}
            <ul>
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="container footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    <p>{{ powered_by_link }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "brand", "label": "Brand name", "default": "Shuffle Mode" },
    { "type": "textarea", "id": "blurb", "label": "Blurb", "default": "Dress for the mood, not the occasion. Limited weekly drops, made in small batches." }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Shop" } },
        { "type": "column", "settings": { "heading": "Help" } },
        { "type": "column", "settings": { "heading": "Shuffle Mode" } }
      ]
    }
  ]
}
{% endschema %}
