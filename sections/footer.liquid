{%- liquid
  assign ig_url  = section.settings.instagram_url
  assign tt_url  = section.settings.tiktok_url
  assign pin_url = section.settings.pinterest_url
  assign nl_placeholder = section.settings.newsletter_placeholder | default: 'Your email address'
  assign nl_label       = section.settings.newsletter_label | default: 'Stay in the loop'
-%}

<footer
  class="sm-footer"
  style="
    --sm-footer-bg: var(--color-ink);
    --sm-footer-fg: var(--color-cream);
    --sm-footer-muted: rgba(251,249,244,0.55);
    --sm-footer-ember: #e98e6f;
    --sm-footer-line: rgba(251,249,244,0.10);
  "
  aria-label="Site footer"
>

  {%- comment -%} ── TOP BAND ── {%- endcomment -%}
  <div class="sm-footer__top">
    <div class="container sm-footer__top-inner">

      {%- comment -%} Brand column {%- endcomment -%}
      <div class="sm-footer__brand-col">
        <p class="sm-footer__wordmark" aria-label="{{ section.settings.brand | default: shop.name }}">
          {{- section.settings.brand | default: shop.name -}}<span class="sm-footer__dot" aria-hidden="true">.</span>
        </p>

        {%- if section.settings.blurb != blank -%}
          <p class="sm-footer__blurb">{{ section.settings.blurb }}</p>
        {%- endif -%}

        {%- comment -%} Social links {%- endcomment -%}
        <nav class="sm-footer__social" aria-label="Social media">
          {%- if ig_url != blank -%}
            <a href="{{ ig_url }}" class="sm-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg class="sm-footer__social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                <circle cx="12" cy="12" r="4"/>
                <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
              </svg>
              <span class="sm-footer__social-label">Instagram</span>
            </a>
          {%- endif -%}

          {%- if tt_url != blank -%}
            <a href="{{ tt_url }}" class="sm-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg class="sm-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.32 6.32 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V9.02a8.22 8.22 0 0 0 4.8 1.54V7.12a4.85 4.85 0 0 1-1.03-.43z"/>
              </svg>
              <span class="sm-footer__social-label">TikTok</span>
            </a>
          {%- endif -%}

          {%- if pin_url != blank -%}
            <a href="{{ pin_url }}" class="sm-footer__social-link" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg class="sm-footer__social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M12 2C6.477 2 2 6.477 2 12c0 4.236 2.636 7.855 6.356 9.312-.088-.791-.167-2.005.035-2.868.19-.78 1.267-5.374 1.267-5.374s-.323-.646-.323-1.602c0-1.502.871-2.626 1.954-2.626.921 0 1.368.692 1.368 1.52 0 .926-.59 2.313-.894 3.6-.255 1.074.538 1.949 1.595 1.949 1.913 0 3.386-2.016 3.386-4.927 0-2.577-1.852-4.374-4.497-4.374-3.063 0-4.862 2.297-4.862 4.672 0 .925.356 1.916.8 2.457a.32.32 0 0 1 .074.307c-.082.337-.263 1.074-.298 1.224-.047.197-.157.239-.362.144-1.35-.63-2.194-2.602-2.194-4.188 0-3.404 2.473-6.531 7.13-6.531 3.745 0 6.655 2.669 6.655 6.236 0 3.72-2.344 6.71-5.598 6.71-1.094 0-2.123-.569-2.475-1.239l-.673 2.512c-.244.937-.9 2.109-1.341 2.823A10 10 0 0 0 12 22c5.523 0 10-4.477 10-10S17.523 2 12 2z"/>
              </svg>
              <span class="sm-footer__social-label">Pinterest</span>
            </a>
          {%- endif -%}
        </nav>

        {%- comment -%} Newsletter {%- endcomment -%}
        {%- if section.settings.show_newsletter -%}
          <div class="sm-footer__newsletter">
            <p class="sm-footer__nl-label">{{ nl_label }}</p>
            <form class="sm-footer__nl-form" action="{{ routes.root_url }}" method="get" aria-label="Newsletter signup">
              <label for="sm-footer-email" class="sm-footer__sr-only">Email address</label>
              <input
                id="sm-footer-email"
                class="sm-footer__nl-input"
                type="email"
                name="contact[email]"
                placeholder="{{ nl_placeholder }}"
                autocomplete="email"
                required
              >
              <button class="sm-footer__nl-btn" type="submit" aria-label="Subscribe">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="18" height="18">
                  <line x1="3" y1="10" x2="17" y2="10"/>
                  <polyline points="11 4 17 10 11 16"/>
                </svg>
              </button>
            </form>
            <p class="sm-footer__nl-reassure">No spam. Unsubscribe anytime.</p>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Menu columns {%- endcomment -%}
      {%- if section.blocks.size > 0 -%}
        <nav class="sm-footer__cols" aria-label="Footer navigation">
          {%- for block in section.blocks -%}
            <div class="sm-footer__col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="sm-footer__col-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.menu != blank -%}
                <ul class="sm-footer__col-list" role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li class="sm-footer__col-item">
                      <a
                        href="{{ link.url }}"
                        class="sm-footer__col-link{% if link.active %} sm-footer__col-link--active{% endif %}"
                        {% if link.active %}aria-current="page"{% endif %}
                      >{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </nav>
      {%- endif -%}

    </div>
  </div>

  {%- comment -%} ── COMPANY LEGITIMACY BAND ── {%- endcomment -%}
  <div class="sm-footer__company">
    <div class="container sm-footer__company-inner">
      <div class="sm-footer__company-identity">
        <p class="sm-footer__company-name">{{ section.settings.brand | default: shop.name }}</p>
        <p class="sm-footer__company-location">
          {%- if section.settings.business_address != blank -%}
            {{ section.settings.business_address }}&ensp;&middot;&ensp;
          {%- endif -%}
          Based in Boston, MA&ensp;&middot;&ensp;United States
        </p>
      </div>
      <div class="sm-footer__company-contact">
        {%- assign contact_email = section.settings.contact_email | default: 'hello@shufflemode.us' -%}
        <a href="mailto:{{ contact_email }}" class="sm-footer__contact-link">
          <svg class="sm-footer__contact-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="14" height="14">
            <rect x="2" y="5" width="16" height="11" rx="2"/>
            <polyline points="2,5 10,12 18,5"/>
          </svg>
          {{ contact_email }}
        </a>
        <a href="/pages/contact" class="sm-footer__contact-page-link">Contact us</a>
      </div>
    </div>
  </div>

  {%- comment -%} ── TRUST / PAYMENTS BAND ── {%- endcomment -%}
  <div class="sm-footer__trust">
    <div class="container sm-footer__trust-inner">
      <div class="sm-footer__secure">
        <svg class="sm-footer__secure-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="15" height="15">
          <rect x="4" y="9" width="12" height="9" rx="2"/>
          <path d="M7 9V6a3 3 0 0 1 6 0v3"/>
          <circle cx="10" cy="14" r="1" fill="currentColor" stroke="none"/>
        </svg>
        <span class="sm-footer__secure-text">Secure checkout</span>
      </div>

      <div class="sm-footer__trust-divider" aria-hidden="true"></div>

      <div class="sm-footer__payments" aria-label="Accepted payment methods" role="list">
        {%- comment -%} Visa {%- endcomment -%}
        <span class="sm-footer__payment-chip sm-footer__payment-chip--visa" role="listitem" aria-label="Visa">
          <span class="sm-footer__pm-wordmark sm-footer__pm-visa" aria-hidden="true">VISA</span>
        </span>
        {%- comment -%} Mastercard — overlapping circles icon + label {%- endcomment -%}
        <span class="sm-footer__payment-chip" role="listitem" aria-label="Mastercard">
          <svg class="sm-footer__mc-circles" viewBox="0 0 32 20" aria-hidden="true" focusable="false" width="32" height="20">
            <circle cx="11" cy="10" r="9" fill="#c2502e" opacity="0.85"/>
            <circle cx="21" cy="10" r="9" fill="#e98e6f" opacity="0.75"/>
          </svg>
          <span class="sm-footer__sr-only">Mastercard</span>
        </span>
        {%- comment -%} American Express {%- endcomment -%}
        <span class="sm-footer__payment-chip" role="listitem" aria-label="American Express">
          <span class="sm-footer__pm-wordmark sm-footer__pm-amex" aria-hidden="true">AMEX</span>
        </span>
        {%- comment -%} Apple Pay {%- endcomment -%}
        <span class="sm-footer__payment-chip" role="listitem" aria-label="Apple Pay">
          <span class="sm-footer__pm-wordmark" aria-hidden="true">Apple Pay</span>
        </span>
        {%- comment -%} Shop Pay {%- endcomment -%}
        <span class="sm-footer__payment-chip" role="listitem" aria-label="Shop Pay">
          <span class="sm-footer__pm-wordmark sm-footer__pm-shoppay" aria-hidden="true">
            <svg class="sm-footer__pm-shoppay-bag" viewBox="0 0 12 14" fill="none" aria-hidden="true" focusable="false" width="9" height="11">
              <path d="M2 4.5C2 2.567 3.567 1 5.5 1h1C8.433 1 10 2.567 10 4.5V5h1a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h1v-.5Z" stroke="currentColor" stroke-width="1.1"/>
            </svg>
            Shop Pay
          </span>
        </span>
        {%- comment -%} PayPal {%- endcomment -%}
        <span class="sm-footer__payment-chip" role="listitem" aria-label="PayPal">
          <span class="sm-footer__pm-wordmark sm-footer__pm-paypal" aria-hidden="true">PayPal</span>
        </span>
      </div>
    </div>
  </div>

  {%- comment -%} ── BOTTOM BAR ── {%- endcomment -%}
  <div class="sm-footer__bottom">
    <div class="container sm-footer__bottom-inner">
      <p class="sm-footer__copy">
        &copy; {{ 'now' | date: '%Y' }}&ensp;{{ shop.name }}.&ensp;All rights reserved.
      </p>

      <nav class="sm-footer__legal" aria-label="Legal links">
        {%- if shop.policies.size > 0 -%}
          {%- assign visible_policies = shop.policies | where: 'body' -%}
          {%- for policy in visible_policies -%}
            <a href="{{ policy.url }}" class="sm-footer__legal-link">{{ policy.title }}</a>
            {%- unless forloop.last -%}<span class="sm-footer__legal-dot" aria-hidden="true">&middot;</span>{%- endunless -%}
          {%- endfor -%}
        {%- else -%}
          <a href="/policies/privacy-policy" class="sm-footer__legal-link">Privacy</a>
          <span class="sm-footer__legal-dot" aria-hidden="true">&middot;</span>
          <a href="/policies/refund-policy" class="sm-footer__legal-link">Returns</a>
          <span class="sm-footer__legal-dot" aria-hidden="true">&middot;</span>
          <a href="/policies/shipping-policy" class="sm-footer__legal-link">Shipping</a>
          <span class="sm-footer__legal-dot" aria-hidden="true">&middot;</span>
          <a href="/policies/terms-of-service" class="sm-footer__legal-link">Terms</a>
        {%- endif -%}
      </nav>

      <p class="sm-footer__powered">{{ powered_by_link }}</p>
    </div>
  </div>

</footer>

{% stylesheet %}

/* ─────────────────────────────────────────────
   SM-FOOTER  —  Shuffle Mode editorial footer
   ───────────────────────────────────────────── */

.sm-footer {
  background-color: var(--color-ink);
  color: var(--sm-footer-fg, var(--color-cream));
  font-family: var(--font-body, 'Inter', sans-serif);
}

/* ── TOP BAND ── */

.sm-footer__top {
  padding-block: 5rem 4rem;
  border-bottom: 1px solid var(--sm-footer-line);
}

.sm-footer__top-inner {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3.5rem;
}

@media (min-width: 768px) {
  .sm-footer__top-inner {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 2fr);
    gap: 4rem;
    align-items: start;
  }
}

/* Wordmark */

.sm-footer__wordmark {
  font-family: var(--font-display, 'Fraunces', serif);
  font-size: clamp(2.25rem, 5vw, 3.5rem);
  font-weight: 300;
  letter-spacing: -0.02em;
  line-height: 1;
  color: var(--sm-footer-fg);
  margin: 0 0 1.25rem;
}

.sm-footer__dot {
  color: var(--sm-footer-ember);
}

/* Blurb */

.sm-footer__blurb {
  font-size: 0.9375rem;
  line-height: 1.65;
  color: var(--sm-footer-muted);
  max-width: 22rem;
  margin: 0 0 2rem;
}

/* Social */

.sm-footer__social {
  display: flex;
  gap: 0.25rem;
  flex-wrap: wrap;
  margin-bottom: 2.5rem;
}

.sm-footer__social-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--sm-footer-line);
  border-radius: 2rem;
  color: var(--sm-footer-muted);
  text-decoration: none;
  font-size: 0.8125rem;
  letter-spacing: 0.04em;
  transition: color 0.2s ease, border-color 0.2s ease;
}

.sm-footer__social-link:hover,
.sm-footer__social-link:focus-visible {
  color: var(--sm-footer-ember);
  border-color: var(--sm-footer-ember);
  outline: none;
}

.sm-footer__social-link:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: 2px;
}

.sm-footer__social-icon {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
}

.sm-footer__social-label {
  font-size: 0.75rem;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}

/* Newsletter */

.sm-footer__newsletter {
  margin-top: 0.25rem;
}

.sm-footer__nl-label {
  font-size: 0.6875rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--sm-footer-muted);
  margin: 0 0 0.75rem;
}

.sm-footer__nl-form {
  display: flex;
  align-items: stretch;
  max-width: 22rem;
  border: 1px solid var(--sm-footer-line);
  border-radius: 2px;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.sm-footer__nl-form:focus-within {
  border-color: var(--sm-footer-ember);
}

.sm-footer__nl-input {
  flex: 1;
  background: transparent;
  border: none;
  padding: 0.75rem 1rem;
  color: var(--sm-footer-fg);
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 0.875rem;
  outline: none;
}

.sm-footer__nl-input::placeholder {
  color: var(--sm-footer-muted);
}

.sm-footer__nl-btn {
  background: transparent;
  border: none;
  border-left: 1px solid var(--sm-footer-line);
  padding: 0.75rem 1rem;
  color: var(--sm-footer-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  transition: color 0.2s ease, background-color 0.2s ease;
}

.sm-footer__nl-btn:hover,
.sm-footer__nl-btn:focus-visible {
  color: var(--sm-footer-ember);
  background-color: rgba(194,80,46,0.08);
  outline: none;
}

.sm-footer__nl-btn:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: -2px;
}

/* Menu columns */

.sm-footer__cols {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
  gap: 2.5rem 2rem;
}

.sm-footer__col-heading {
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 0.625rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sm-footer-muted);
  margin: 0 0 1.125rem;
}

.sm-footer__col-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}

.sm-footer__col-link {
  color: var(--sm-footer-fg);
  text-decoration: none;
  font-size: 0.9375rem;
  font-weight: 300;
  line-height: 1.4;
  opacity: 0.85;
  transition: opacity 0.15s ease, color 0.15s ease;
  display: inline-block;
}

.sm-footer__col-link:hover,
.sm-footer__col-link:focus-visible {
  opacity: 1;
  color: var(--sm-footer-ember);
  outline: none;
}

.sm-footer__col-link:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: 2px;
  border-radius: 1px;
}

.sm-footer__col-link--active {
  color: var(--sm-footer-ember);
  opacity: 1;
}

/* ── NEWSLETTER REASSURANCE ── */

.sm-footer__nl-reassure {
  font-size: 0.6875rem;
  color: rgba(251,249,244,0.38);
  margin: 0.625rem 0 0;
  letter-spacing: 0.03em;
}

/* ── COMPANY LEGITIMACY BAND ── */

.sm-footer__company {
  border-top: 1px solid var(--sm-footer-line);
  padding-block: 1.5rem;
}

.sm-footer__company-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 1rem 2rem;
}

.sm-footer__company-identity {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.sm-footer__company-name {
  font-family: var(--font-display, 'Fraunces', serif);
  font-size: 0.9375rem;
  font-weight: 400;
  color: var(--sm-footer-fg);
  margin: 0;
  letter-spacing: 0.01em;
}

.sm-footer__company-location {
  font-size: 0.75rem;
  color: var(--sm-footer-muted);
  margin: 0;
  letter-spacing: 0.03em;
}

.sm-footer__company-contact {
  display: flex;
  align-items: center;
  gap: 1.25rem;
  flex-wrap: wrap;
}

.sm-footer__contact-link {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.8125rem;
  color: var(--sm-footer-muted);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: color 0.15s ease;
}

.sm-footer__contact-link:hover,
.sm-footer__contact-link:focus-visible {
  color: var(--sm-footer-ember);
  outline: none;
}

.sm-footer__contact-link:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: 2px;
  border-radius: 1px;
}

.sm-footer__contact-icon {
  flex-shrink: 0;
  opacity: 0.7;
}

.sm-footer__contact-page-link {
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sm-footer-ember);
  text-decoration: none;
  border-bottom: 1px solid rgba(233,142,111,0.35);
  padding-bottom: 1px;
  transition: border-color 0.15s ease, color 0.15s ease;
}

.sm-footer__contact-page-link:hover,
.sm-footer__contact-page-link:focus-visible {
  color: var(--sm-footer-fg);
  border-color: var(--sm-footer-fg);
  outline: none;
}

.sm-footer__contact-page-link:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: 2px;
  border-radius: 1px;
}

/* ── TRUST BAND ── */

.sm-footer__trust {
  border-bottom: 1px solid var(--sm-footer-line);
  padding-block: 1.125rem;
}

.sm-footer__trust-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.75rem 1.5rem;
}

.sm-footer__secure {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  flex-shrink: 0;
}

.sm-footer__secure-icon {
  color: var(--sm-footer-ember);
  flex-shrink: 0;
}

.sm-footer__secure-text {
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sm-footer-muted);
  white-space: nowrap;
}

.sm-footer__trust-divider {
  width: 1px;
  height: 1.25rem;
  background: var(--sm-footer-line);
  flex-shrink: 0;
}

@media (max-width: 479px) {
  .sm-footer__trust-divider { display: none; }
}

.sm-footer__payments {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
  align-items: center;
}

.sm-footer__payment-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: var(--sm-footer-muted);
  border: 1px solid var(--sm-footer-line);
  border-radius: 4px;
  padding: 0.25rem 0.5rem;
  background: rgba(251,249,244,0.04);
  line-height: 1;
  min-height: 1.875rem;
}

/* Payment wordmarks — plain text, reliably rendered */
.sm-footer__pm-wordmark {
  font-family: var(--font-body, 'Inter', sans-serif);
  font-size: 0.6875rem;
  letter-spacing: 0.03em;
  color: var(--sm-footer-muted);
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.sm-footer__pm-visa {
  font-weight: 800;
  letter-spacing: 0.08em;
  font-style: italic;
}

.sm-footer__pm-amex {
  font-weight: 700;
  letter-spacing: 0.05em;
}

.sm-footer__pm-shoppay {
  font-weight: 500;
}

.sm-footer__pm-paypal {
  font-weight: 600;
}

.sm-footer__pm-shoppay-bag {
  opacity: 0.75;
  flex-shrink: 0;
}

/* Mastercard — overlapping circles only (no text needed, aria-label covers it) */
.sm-footer__mc-circles {
  display: block;
  flex-shrink: 0;
}

/* ── BOTTOM BAR ── */

.sm-footer__bottom {
  padding-block: 1.375rem;
}

.sm-footer__bottom-inner {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem 1.5rem;
}

.sm-footer__copy {
  font-size: 0.75rem;
  color: var(--sm-footer-muted);
  margin: 0;
  letter-spacing: 0.02em;
}

.sm-footer__legal {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem 0.5rem;
}

.sm-footer__legal-link {
  font-size: 0.75rem;
  color: var(--sm-footer-muted);
  text-decoration: none;
  letter-spacing: 0.02em;
  transition: color 0.15s ease;
}

.sm-footer__legal-link:hover,
.sm-footer__legal-link:focus-visible {
  color: var(--sm-footer-fg);
  outline: none;
}

.sm-footer__legal-link:focus-visible {
  outline: 2px solid var(--sm-footer-ember);
  outline-offset: 2px;
  border-radius: 1px;
}

.sm-footer__legal-dot {
  font-size: 0.625rem;
  color: rgba(251,249,244,0.2);
  line-height: 1;
  user-select: none;
}

.sm-footer__powered {
  font-size: 0.6875rem;
  color: rgba(251,249,244,0.3);
  margin: 0;
}

.sm-footer__powered a {
  color: inherit;
  text-decoration: none;
  transition: color 0.15s ease;
}

.sm-footer__powered a:hover {
  color: var(--sm-footer-muted);
}

/* Accessibility */

.sm-footer__sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border-width: 0;
}

/* Reduced motion */

@media (prefers-reduced-motion: reduce) {
  .sm-footer__social-link,
  .sm-footer__col-link,
  .sm-footer__nl-btn,
  .sm-footer__nl-form,
  .sm-footer__legal-link,
  .sm-footer__contact-link,
  .sm-footer__contact-page-link {
    transition: none;
  }
}

{% endstylesheet %}

