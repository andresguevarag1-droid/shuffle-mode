{% stylesheet %}
/* ── Cart Page ── */
.smc-cart {
  padding: var(--smc-cart-pad-y, 4rem) 0 6rem;
}

/* ── Checkout confidence strip ── */
.smc-secure {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.75rem 0 0.5rem;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-stone);
}

.smc-secure__icon {
  width: 0.875rem;
  height: 0.875rem;
  flex-shrink: 0;
  color: var(--color-stone);
}

/* Payment method wordmarks */
.smc-payment {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.375rem 0.75rem;
  padding: 0.625rem 0 0.875rem;
  border-bottom: 1px solid var(--color-line);
  margin-bottom: 1rem;
}

.smc-payment__mark {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 600;
  letter-spacing: 0.06em;
  color: var(--color-stone);
  opacity: 0.85;
  white-space: nowrap;
}

.smc-payment__dot {
  font-size: 0.4375rem;
  color: var(--color-stone);
  opacity: 0.4;
  line-height: 1;
}

/* Reassurance row */
.smc-reassurance {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.375rem 0.875rem;
  padding: 0 0 1.25rem;
  border-bottom: 1px solid var(--color-line);
  margin-bottom: 1.25rem;
}

.smc-reassurance__item {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  letter-spacing: 0.07em;
  color: var(--color-stone);
  white-space: nowrap;
}

.smc-reassurance__dot {
  font-size: 0.4375rem;
  color: var(--color-stone);
  opacity: 0.4;
  line-height: 1;
}

.smc-cart__header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  padding-bottom: 1.5rem;
  border-bottom: 1px solid var(--color-line);
  margin-bottom: 2.5rem;
}

.smc-cart__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 300;
  font-style: italic;
  color: var(--color-ink);
  letter-spacing: -0.02em;
  line-height: 1;
  margin: 0;
}

.smc-cart__count {
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-stone);
}

/* ── Free shipping bar ── */
.smc-freeship {
  background: var(--color-sand);
  border-radius: 2px;
  padding: 1rem 1.5rem;
  margin-bottom: 2.5rem;
  display: flex;
  align-items: center;
  gap: 1rem;
  overflow: hidden;
  position: relative;
}

.smc-freeship__track {
  position: absolute;
  inset: 0;
  background: var(--color-ember);
  opacity: 0.08;
  transform-origin: left center;
  transform: scaleX(var(--smc-fs-progress, 0));
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.smc-freeship__icon {
  flex-shrink: 0;
  width: 1.25rem;
  height: 1.25rem;
  color: var(--color-ember);
}

.smc-freeship__text {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  letter-spacing: 0.04em;
  color: var(--color-ink);
  position: relative;
}

.smc-freeship__text strong {
  font-weight: 600;
}

.smc-freeship--unlocked .smc-freeship__icon {
  color: #3a7d44;
}

.smc-freeship--unlocked .smc-freeship__track {
  background: #3a7d44;
  opacity: 0.1;
  transform: scaleX(1);
}

/* ── Layout ── */
.smc-cart__body {
  display: grid;
  grid-template-columns: 1fr;
  gap: 3rem;
  align-items: start;
}

@media (min-width: 900px) {
  .smc-cart__body {
    grid-template-columns: 1fr 360px;
    gap: 4rem;
  }
}

/* ── Line items ── */
.smc-lines {
  list-style: none;
  margin: 0;
  padding: 0;
}

.smc-line {
  display: grid;
  grid-template-columns: 88px 1fr auto;
  gap: 1.25rem 1.5rem;
  align-items: start;
  padding: 1.75rem 0;
  border-bottom: 1px solid var(--color-line);
  position: relative;
}

.smc-line:first-child {
  border-top: 1px solid var(--color-line);
}

/* image */
.smc-line__media {
  display: block;
  width: 88px;
  height: 112px;
  background: var(--color-sand);
  overflow: hidden;
  border-radius: 1px;
  flex-shrink: 0;
}

.smc-line__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.smc-line__media:hover img {
  transform: scale(1.04);
}

/* info */
.smc-line__info {
  display: flex;
  flex-direction: column;
  gap: 0.35rem;
  padding-top: 0.125rem;
}

.smc-line__name {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 400;
  color: var(--color-ink);
  text-decoration: none;
  letter-spacing: -0.01em;
  line-height: 1.3;
}

.smc-line__name:hover {
  color: var(--color-ember);
}

.smc-line__variant {
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-stone);
}

.smc-line__stepper {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 0.75rem;
  border: 1px solid var(--color-line);
  border-radius: 2px;
  width: fit-content;
  background: var(--color-cream);
}

.smc-line__stepper-btn {
  appearance: none;
  background: transparent;
  border: none;
  width: 2rem;
  height: 2rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-ink);
  font-size: 1rem;
  line-height: 1;
  transition: background 0.15s, color 0.15s;
  border-radius: 2px;
  flex-shrink: 0;
}

.smc-line__stepper-btn:hover {
  background: var(--color-sand);
}

.smc-line__stepper-btn:active {
  background: var(--color-ember);
  color: var(--color-cream);
}

.smc-line__qty {
  width: 2.5rem;
  text-align: center;
  border: none;
  border-left: 1px solid var(--color-line);
  border-right: 1px solid var(--color-line);
  background: transparent;
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-ink);
  padding: 0;
  height: 2rem;
  -moz-appearance: textfield;
}

.smc-line__qty::-webkit-inner-spin-button,
.smc-line__qty::-webkit-outer-spin-button {
  -webkit-appearance: none;
}

.smc-line__remove {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-stone);
  text-decoration: none;
  margin-top: 0.75rem;
  transition: color 0.15s;
}

.smc-line__remove:hover {
  color: var(--color-ember);
}

/* price */
.smc-line__price {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 400;
  color: var(--color-ink);
  text-align: right;
  white-space: nowrap;
  padding-top: 0.125rem;
}

/* ── Summary panel ── */
.smc-summary {
  background: var(--color-bone);
  padding: 2rem;
  border-radius: 2px;
  position: sticky;
  top: 6rem;
}

.smc-summary__title {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-stone);
  margin: 0 0 1.5rem;
}

.smc-summary__row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  padding: 0.625rem 0;
  border-bottom: 1px solid var(--color-line);
}

.smc-summary__label {
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-stone);
}

.smc-summary__value {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 400;
  color: var(--color-ink);
}

.smc-summary__total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  padding: 1.25rem 0 1.5rem;
}

.smc-summary__total-label {
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ink);
  font-weight: 600;
}

.smc-summary__total-value {
  font-family: var(--font-display);
  font-size: 1.5rem;
  font-weight: 300;
  font-style: italic;
  color: var(--color-ink);
  letter-spacing: -0.02em;
}

.smc-summary__checkout {
  display: block;
  width: 100%;
  padding: 1rem 1.5rem;
  background: var(--color-ink);
  color: var(--color-cream);
  border: none;
  border-radius: 2px;
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.2s, transform 0.15s;
  margin-bottom: 0.75rem;
}

.smc-summary__checkout:hover {
  background: var(--color-ember);
}

.smc-summary__checkout:active {
  transform: scale(0.99);
}

.smc-summary__update {
  display: block;
  width: 100%;
  padding: 0.875rem 1.5rem;
  background: transparent;
  color: var(--color-stone);
  border: 1px solid var(--color-line);
  border-radius: 2px;
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: border-color 0.15s, color 0.15s;
  margin-bottom: 1.5rem;
}

.smc-summary__update:hover {
  border-color: var(--color-ink);
  color: var(--color-ink);
}

/* trust badges */
.smc-trust {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}

.smc-trust__item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--color-stone);
  letter-spacing: 0.02em;
}

.smc-trust__icon {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  color: var(--color-stone);
}

/* ── Empty state ── */
.smc-empty {
  padding: var(--smc-empty-pad, 6rem) 0 8rem;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.5rem;
}

.smc-empty__eyebrow {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-stone);
}

.smc-empty__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 5vw, 3.5rem);
  font-weight: 300;
  font-style: italic;
  color: var(--color-ink);
  letter-spacing: -0.03em;
  line-height: 1.1;
  margin: 0;
  max-width: 18ch;
}

.smc-empty__sub {
  font-family: var(--font-body);
  font-size: 0.9375rem;
  color: var(--color-stone);
  line-height: 1.6;
  max-width: 36ch;
  margin: 0;
}

.smc-empty__divider {
  width: 2.5rem;
  height: 1px;
  background: var(--color-line);
  border: none;
  margin: 0;
}

.smc-empty__cta {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.875rem 2rem;
  background: var(--color-ink);
  color: var(--color-cream);
  text-decoration: none;
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  border-radius: 2px;
  transition: background 0.2s, transform 0.15s;
}

.smc-empty__cta:hover {
  background: var(--color-ember);
}

.smc-empty__cta:active {
  transform: scale(0.98);
}

/* ── Reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .smc-freeship__track,
  .smc-line__media img,
  .smc-summary__checkout,
  .smc-empty__cta {
    transition: none;
  }
}

/* ── trust items: tighten icon reuse ── */
.smc-trust__icon {
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
  color: var(--color-stone);
}

/* ═══════════════════════════════════════════════
   CART — RESPONSIVE ADDITIONS
   ≤600px: summary stacks below items (already 1-col)
   ≤480px: line items tighten, summary full-width
   ≤380px: critical 320px survival rules
   ═══════════════════════════════════════════════ */

/* Prevent any child from blowing out the cart container */
.smc-cart {
  overflow-x: hidden;
}

/* ── Cart header scales on small phones ──────── */
@media (max-width: 480px) {
  .smc-cart__header {
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }
  .smc-cart__title {
    font-size: clamp(1.5rem, 7vw, 2rem);
  }
}
@media (max-width: 380px) {
  .smc-cart__title {
    font-size: clamp(1.25rem, 8vw, 1.75rem);
  }
}

/* ── Free shipping bar: tighten on phones ────── */
@media (max-width: 480px) {
  .smc-freeship {
    padding: 0.75rem 1rem;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }
  .smc-freeship__text {
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }
}
@media (max-width: 380px) {
  .smc-freeship {
    padding: 0.625rem 0.875rem;
    gap: 0.5rem;
  }
}

/* ── Line items: don't overflow at 320px ──────── */
.smc-line {
  /* allow details column to shrink so price doesn't overflow */
  min-width: 0;
}

/* Give the details column min-width:0 so it can shrink */
.smc-line__info {
  min-width: 0;
  overflow-wrap: anywhere;
}

.smc-line__name {
  overflow-wrap: anywhere;
}

/* Tighten line layout on phones */
@media (max-width: 600px) {
  .smc-line {
    grid-template-columns: 76px 1fr auto;
    gap: 1rem 1rem;
    padding: 1.25rem 0;
  }
  .smc-line__media {
    width: 76px;
    height: 96px;
  }
}

@media (max-width: 480px) {
  .smc-line {
    grid-template-columns: 64px 1fr auto;
    gap: 0.875rem 0.75rem;
    padding: 1rem 0;
  }
  .smc-line__media {
    width: 64px;
    height: 80px;
  }
  .smc-line__name {
    font-size: 0.9375rem;
  }
  .smc-line__variant {
    font-size: 0.6875rem;
  }
  .smc-line__price {
    font-size: 0.9375rem;
  }
}

@media (max-width: 380px) {
  /* Collapse to 2-col: image + (info + price stacked) */
  .smc-line {
    grid-template-columns: 56px 1fr;
    grid-template-rows: auto auto;
    gap: 0.75rem 0.625rem;
    padding: 0.875rem 0;
  }
  .smc-line__media {
    width: 56px;
    height: 72px;
    grid-row: 1 / 3;
  }
  .smc-line__info {
    grid-column: 2;
    grid-row: 1;
  }
  .smc-line__price {
    grid-column: 2;
    grid-row: 2;
    text-align: left;
    font-size: 0.875rem;
  }
}

/* ── Qty stepper: ≥44px tap targets ─────────── */
.smc-line__stepper-btn {
  /* upgrade to 44px min to meet tap target requirement */
  min-width: 44px;
  min-height: 44px;
  width: 2.75rem;
  height: 2.75rem;
}
.smc-line__qty {
  height: 2.75rem;
  min-height: 44px;
}

@media (max-width: 380px) {
  .smc-line__stepper-btn {
    min-width: 40px;
    min-height: 44px;
    width: 2.5rem;
    height: 2.75rem;
  }
  .smc-line__qty {
    width: 2.25rem;
  }
}

/* ── Remove link: always reachable ──────────── */
.smc-line__remove {
  /* Ensure the remove link is a minimum touch target */
  min-height: 44px;
  display: inline-flex;
  align-items: center;
}

/* ── Summary panel: full-width on phones ─────── */
@media (max-width: 899px) {
  .smc-summary {
    /* unstick on mobile (sticky top is irrelevant stacked) */
    position: static;
    /* reduce side padding on phones */
    padding: 1.5rem;
  }
}

@media (max-width: 480px) {
  .smc-summary {
    padding: 1.25rem;
  }
  .smc-summary__checkout {
    padding: 0.9rem 1rem;
    min-height: 44px;
    font-size: 0.7rem;
  }
  .smc-summary__update {
    padding: 0.8rem 1rem;
    min-height: 44px;
    font-size: 0.7rem;
  }
  .smc-summary__total-value {
    font-size: 1.25rem;
  }
}

@media (max-width: 380px) {
  .smc-summary {
    padding: 1rem;
  }
  .smc-summary__title {
    font-size: 0.625rem;
    margin-bottom: 1rem;
  }
  .smc-summary__label {
    font-size: 0.8125rem;
  }
  .smc-summary__value {
    font-size: 0.9375rem;
  }
}

/* ── Payment row: wrap on tiny screens ──────── */
@media (max-width: 480px) {
  .smc-payment {
    gap: 0.3rem 0.5rem;
    padding: 0.5rem 0 0.625rem;
  }
  .smc-payment__mark {
    font-size: 0.625rem;
  }
}

/* ── Reassurance row: wrap gracefully ─────────── */
@media (max-width: 480px) {
  .smc-reassurance {
    gap: 0.3rem 0.625rem;
    padding: 0 0 1rem;
  }
  .smc-reassurance__item {
    font-size: 0.625rem;
    white-space: normal;
    overflow-wrap: anywhere;
  }
}

/* ── Secure strip: prevent overflow ─────────── */
@media (max-width: 380px) {
  .smc-secure {
    font-size: 0.625rem;
    gap: 0.375rem;
    padding: 0.625rem 0 0.375rem;
  }
}

/* ── Empty state: scale text ─────────────────── */
@media (max-width: 480px) {
  .smc-empty {
    padding: 4rem 0 6rem;
    gap: 1.25rem;
  }
  .smc-empty__title {
    font-size: clamp(1.75rem, 8vw, 2.5rem);
  }
  .smc-empty__sub {
    font-size: 0.875rem;
  }
}
@media (max-width: 380px) {
  .smc-empty__title {
    font-size: clamp(1.5rem, 9vw, 2rem);
  }
  .smc-empty__cta {
    padding: 0.75rem 1.5rem;
    font-size: 0.7rem;
    min-height: 44px;
  }
}
{% endstylesheet %}

<section class="smc-cart container" aria-label="{{ 'cart.general.title' | t }}">

  {%- if cart.item_count > 0 -%}

    {%- comment -%} Free shipping bar {%- endcomment -%}
    {%- assign threshold_cents = settings.free_shipping_threshold | times: 100 -%}
    {%- if threshold_cents > 0 -%}
      {%- assign fs_progress = cart.total_price | times: 1.0 | divided_by: threshold_cents -%}
      {%- if fs_progress > 1 -%}{%- assign fs_progress = 1 -%}{%- endif -%}
      {%- assign fs_progress_pct = fs_progress | round: 4 -%}
      {%- if cart.total_price >= threshold_cents -%}
        <div class="smc-freeship smc-freeship--unlocked" role="status" aria-live="polite">
          <div class="smc-freeship__track" aria-hidden="true"></div>
          <svg class="smc-freeship__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2.5 10.5l4.5 4.5 10-9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="smc-freeship__text">You&rsquo;ve <strong>unlocked free shipping</strong> — a little luxury, on us.</p>
        </div>
      {%- else -%}
        {%- assign remaining = threshold_cents | minus: cart.total_price -%}
        <div class="smc-freeship" role="status" aria-live="polite" style="--smc-fs-progress: {{ fs_progress_pct }};">
          <div class="smc-freeship__track" aria-hidden="true"></div>
          <svg class="smc-freeship__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 10h14M10 3l7 7-7 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="smc-freeship__text">You&rsquo;re <strong>{{ remaining | money }}</strong> away from complimentary shipping.</p>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Cart header {%- endcomment -%}
    <div class="smc-cart__header">
      <h1 class="smc-cart__title">Your cart</h1>
      <span class="smc-cart__count" aria-live="polite">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</span>
    </div>

    {%- comment -%} Cart form {%- endcomment -%}
    {% form 'cart', cart %}
      <div class="smc-cart__body">

        {%- comment -%} Line items {%- endcomment -%}
        <ul class="smc-lines" aria-label="Cart items">
          {%- for item in cart.items -%}
            <li class="smc-line">
              <a href="{{ item.url }}" class="smc-line__media" tabindex="-1" aria-hidden="true">
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | default: item.title | escape }}"
                    width="88"
                    height="112"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              <div class="smc-line__info">
                <a href="{{ item.url }}" class="smc-line__name">{{ item.product.title }}</a>
                {%- unless item.variant.title contains 'Default' -%}
                  <span class="smc-line__variant">{{ item.variant.title }}</span>
                {%- endunless -%}

                <div class="smc-line__stepper" role="group" aria-label="Quantity for {{ item.product.title | escape }}">
                  <button
                    type="button"
                    class="smc-line__stepper-btn"
                    data-action="decrement"
                    data-target="qty-{{ item.index }}"
                    aria-label="Decrease quantity"
                  >&#8722;</button>
                  <label class="visually-hidden" for="qty-{{ item.index }}">Quantity</label>
                  <input
                    id="qty-{{ item.index }}"
                    class="smc-line__qty"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="Quantity"
                  >
                  <button
                    type="button"
                    class="smc-line__stepper-btn"
                    data-action="increment"
                    data-target="qty-{{ item.index }}"
                    aria-label="Increase quantity"
                  >&#43;</button>
                </div>

                <a href="{{ item.url_to_remove }}" class="smc-line__remove" aria-label="Remove {{ item.product.title | escape }} from cart">
                  <svg class="smc-trust__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 4h10M6 4V3h4v1M5 4l.5 9h5l.5-9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  Remove
                </a>
              </div>

              <div class="smc-line__price" aria-label="Price: {{ item.final_line_price | money }}">
                {{ item.final_line_price | money }}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- comment -%} Order summary {%- endcomment -%}
        <aside class="smc-summary" aria-label="Order summary">
          <p class="smc-summary__title">Order summary</p>

          <div class="smc-summary__row">
            <span class="smc-summary__label">Subtotal</span>
            <span class="smc-summary__value">{{ cart.total_price | money }}</span>
          </div>
          <div class="smc-summary__row">
            <span class="smc-summary__label">Shipping</span>
            <span class="smc-summary__value">Calculated at checkout</span>
          </div>

          <div class="smc-summary__total-row" aria-label="Total: {{ cart.total_price | money }}">
            <span class="smc-summary__total-label">Total</span>
            <span class="smc-summary__total-value">{{ cart.total_price | money }}</span>
          </div>

          <button type="submit" name="checkout" class="smc-summary__checkout">
            Proceed to checkout
          </button>

          {%- comment -%} Secure checkout line — sits directly under CTA for max confidence {%- endcomment -%}
          <div class="smc-secure" aria-label="Secure checkout">
            <svg class="smc-secure__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.1"/>
              <path d="M5 7V5a3 3 0 016 0v2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
              <circle cx="8" cy="10.5" r="1" fill="currentColor"/>
            </svg>
            Secure checkout
          </div>

          {%- if section.settings.show_payment -%}
            <div class="smc-payment" aria-label="Accepted payment methods">
              <span class="smc-payment__mark">Visa</span>
              <span class="smc-payment__dot" aria-hidden="true">&#9679;</span>
              <span class="smc-payment__mark">Mastercard</span>
              <span class="smc-payment__dot" aria-hidden="true">&#9679;</span>
              <span class="smc-payment__mark">Amex</span>
              <span class="smc-payment__dot" aria-hidden="true">&#9679;</span>
              <span class="smc-payment__mark">Apple Pay</span>
              <span class="smc-payment__dot" aria-hidden="true">&#9679;</span>
              <span class="smc-payment__mark">Shop Pay</span>
              <span class="smc-payment__dot" aria-hidden="true">&#9679;</span>
              <span class="smc-payment__mark">PayPal</span>
            </div>
          {%- endif -%}

          {%- if section.settings.reassurance_text != blank -%}
            {%- assign reassurance_parts = section.settings.reassurance_text | split: ' · ' -%}
            <div class="smc-reassurance" aria-label="Shipping and returns assurance">
              {%- for part in reassurance_parts -%}
                <span class="smc-reassurance__item">{{ part | escape }}</span>
                {%- unless forloop.last -%}
                  <span class="smc-reassurance__dot" aria-hidden="true">&#9679;</span>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          <button type="submit" name="update" class="smc-summary__update">
            Update cart
          </button>

          <ul class="smc-trust" aria-label="Trust signals">
            <li class="smc-trust__item">
              <svg class="smc-trust__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M8 2C5.79 2 4 3.79 4 6c0 3 4 8 4 8s4-5 4-8c0-2.21-1.79-4-4-4z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
                <circle cx="8" cy="6" r="1.25" stroke="currentColor" stroke-width="1.1"/>
              </svg>
              Ships from Boston, MA
            </li>
            <li class="smc-trust__item">
              <svg class="smc-trust__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M13 8A5 5 0 1 1 8 3H11" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
                <path d="M9 1l2 2-2 2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              30-day returns
            </li>
            <li class="smc-trust__item">
              <svg class="smc-trust__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.1"/>
                <path d="M8 5v3l2 2" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
              </svg>
              Ships in 1–2 business days
            </li>
          </ul>
        </aside>

      </div>
    {% endform %}

  {%- else -%}

    {%- comment -%} Empty state {%- endcomment -%}
    <div class="smc-empty" role="status">
      <p class="smc-empty__eyebrow">Your cart</p>
      <h1 class="smc-empty__title">Nothing here yet</h1>
      <hr class="smc-empty__divider" aria-hidden="true">
      <p class="smc-empty__sub">The finest pieces are waiting. Explore this week&rsquo;s drop and find something worth keeping.</p>
      <a href="{{ routes.all_products_collection_url }}" class="smc-empty__cta">
        Shop the collection
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M2 7h10M7 2l5 5-5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  {%- endif -%}

</section>

{% javascript %}
(function () {
  'use strict';

  function initSteppers() {
    var btns = document.querySelectorAll('.smc-line__stepper-btn');
    btns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var targetId = btn.getAttribute('data-target');
        var action   = btn.getAttribute('data-action');
        var input    = document.getElementById(targetId);
        if (!input) return;
        var val = parseInt(input.value, 10) || 0;
        if (action === 'increment') {
          input.value = val + 1;
        } else if (action === 'decrement') {
          input.value = Math.max(0, val - 1);
        }
        input.dispatchEvent(new Event('change', { bubbles: true }));
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSteppers);
  } else {
    initSteppers();
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Cart",
  "settings": [
    {
      "type": "header",
      "content": "Checkout confidence"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Show accepted payment methods",
      "default": true,
      "info": "Displays Visa, Mastercard, Amex, Apple Pay, Shop Pay, PayPal beneath the checkout button."
    },
    {
      "type": "text",
      "id": "reassurance_text",
      "label": "Reassurance line",
      "default": "30-day returns · Tracked U.S. shipping · Encrypted payment",
      "info": "Separate items with \" · \" (space-dot-space). Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top padding (rem)",
      "min": 2,
      "max": 10,
      "step": 0.5,
      "default": 4
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom padding (rem)",
      "min": 2,
      "max": 12,
      "step": 0.5,
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
