<section class="container section">
  <h1 class="section__title">{{ 'general.search.results' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" style="margin-top:1.5rem;max-width:32rem;display:flex;gap:0.75rem;">
    <input type="search" name="q" value="{{ search.terms | escape }}" class="input" placeholder="{{ 'general.search.placeholder' | t }}" aria-label="Search">
    <button type="submit" class="btn btn--primary">Search</button>
  </form>

  {%- if search.performed -%}
    <div class="product-grid" style="margin-top:3rem;">
      {%- for item in search.results -%}
        {%- if item.object_type == 'product' -%}
          {% render 'product-card', product: item %}
        {%- else -%}
          <a href="{{ item.url }}" class="card"><h2 class="font-display" style="font-size:1.25rem;">{{ item.title }}</h2></a>
        {%- endif -%}
      {%- else -%}
        <p>No results for &ldquo;{{ search.terms | escape }}&rdquo;.</p>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
