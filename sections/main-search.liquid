{% stylesheet %}
/* ── SMS Search ──────────────────────────────────────────── */
.sms-search {
  padding: var(--sms-hero-pad, clamp(5rem, 12vw, 10rem)) 0 clamp(4rem, 8vw, 7rem);
}

/* ── Hero header ─────────────────────────────────────────── */
.sms-search__hero {
  display: grid;
  grid-template-columns: 1fr;
  row-gap: 0.35em;
  margin-bottom: clamp(2.5rem, 6vw, 5rem);
}

.sms-search__eyebrow {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-stone);
}

.sms-search__headline {
  font-family: var(--font-display);
  font-size: clamp(2.75rem, 8vw, 6.5rem);
  font-weight: 300;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: var(--color-ink);
  margin: 0;
}

.sms-search__headline em {
  font-style: italic;
  color: var(--color-ember);
}

/* ── Form wrapper ────────────────────────────────────────── */
.sms-search__form-wrap {
  position: relative;
  border-bottom: 1.5px solid var(--color-ink);
  display: flex;
  align-items: center;
  gap: 1rem;
  padding-bottom: 1rem;
  max-width: var(--sms-form-max, 52rem);
}

.sms-search__form-wrap:focus-within {
  border-bottom-color: var(--color-ember);
}

.sms-search__input {
  flex: 1;
  background: none;
  border: none;
  outline: none;
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 3.5vw, 2.5rem);
  font-weight: 300;
  font-style: italic;
  color: var(--color-ink);
  caret-color: var(--color-ember);
  padding: 0;
  width: 100%;
}

.sms-search__input::placeholder {
  color: var(--color-stone);
  opacity: 0.55;
}

.sms-search__submit {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 0.4em;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-ink);
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.25em 0;
  transition: color 0.2s;
}

@media (prefers-reduced-motion: no-preference) {
  .sms-search__submit { transition: color 0.2s, gap 0.2s; }
  .sms-search__submit:hover { color: var(--color-ember); gap: 0.65em; }
}

.sms-search__submit:hover { color: var(--color-ember); }

.sms-search__submit-arrow {
  display: inline-block;
  width: 1.1em;
  height: 1.1em;
  stroke: currentColor;
  fill: none;
  stroke-width: 1.5;
}

/* ── Predictive dropdown ─────────────────────────────────── */
.sms-search__predictive {
  position: absolute;
  top: calc(100% + 1.25rem);
  left: 0;
  right: 0;
  background: var(--color-cream);
  border: 1px solid var(--color-line);
  z-index: 200;
  padding: 0.75rem 0;
  display: none;
}

.sms-search__predictive[aria-hidden="false"] { display: block; }

.sms-search__predictive-item {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 0.65rem 1.25rem;
  text-decoration: none;
  color: var(--color-ink);
  transition: background 0.15s;
}

.sms-search__predictive-item:hover,
.sms-search__predictive-item[aria-selected="true"] {
  background: var(--color-sand);
}

.sms-search__predictive-thumb {
  width: 2.5rem;
  height: 2.5rem;
  object-fit: cover;
  background: var(--color-sand);
  flex-shrink: 0;
}

.sms-search__predictive-name {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1.3;
  color: var(--color-ink);
}

.sms-search__predictive-price {
  font-family: var(--font-body);
  font-size: 0.75rem;
  color: var(--color-stone);
  margin-top: 0.1em;
}

/* ── Meta bar ────────────────────────────────────────────── */
.sms-search__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 3rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--color-line);
}

.sms-search__count {
  font-family: var(--font-body);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-stone);
}

.sms-search__count strong {
  color: var(--color-ink);
  font-weight: 600;
}

/* ── Results grid ────────────────────────────────────────── */
.sms-search__grid {
  display: grid;
  grid-template-columns: repeat(var(--sms-cols, 3), 1fr);
  gap: clamp(1.5rem, 3vw, 2.5rem) clamp(1rem, 2vw, 1.5rem);
  margin-top: 2.5rem;
}

@media (max-width: 900px) {
  .sms-search__grid { --sms-cols: 2; }
}

@media (max-width: 560px) {
  .sms-search__grid { --sms-cols: 1; }
}

/* ── Editorial (article / page) card ────────────────────── */
.sms-editorial-card {
  display: block;
  text-decoration: none;
  border-top: 1.5px solid var(--color-ink);
  padding-top: 1.25rem;
  position: relative;
  overflow: hidden;
}

.sms-editorial-card__tag {
  font-family: var(--font-body);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-stone);
  margin-bottom: 0.6em;
}

.sms-editorial-card__title {
  font-family: var(--font-display);
  font-size: clamp(1.15rem, 2.5vw, 1.5rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.2;
  color: var(--color-ink);
  margin: 0 0 0.75em;
}

.sms-editorial-card__excerpt {
  font-family: var(--font-body);
  font-size: 0.8125rem;
  line-height: 1.65;
  color: var(--color-stone);
  margin: 0 0 1em;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.sms-editorial-card__link {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-ink);
  display: inline-flex;
  align-items: center;
  gap: 0.4em;
}

@media (prefers-reduced-motion: no-preference) {
  .sms-editorial-card { transition: opacity 0.2s; }
  .sms-editorial-card:hover { opacity: 0.72; }
}

/* ── Empty state ─────────────────────────────────────────── */
.sms-search__empty {
  padding: clamp(3rem, 8vw, 6rem) 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem 4rem;
  align-items: start;
}

@media (max-width: 700px) {
  .sms-search__empty { grid-template-columns: 1fr; }
}

.sms-search__empty-headline {
  grid-column: 1 / -1;
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 4vw, 2.75rem);
  font-weight: 300;
  font-style: italic;
  color: var(--color-ink);
  margin: 0 0 0.25em;
}

.sms-search__empty-sub {
  grid-column: 1 / -1;
  font-family: var(--font-body);
  font-size: 0.875rem;
  color: var(--color-stone);
  margin: 0 0 1rem;
}

.sms-search__empty-group-label {
  font-family: var(--font-body);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-stone);
  margin: 0 0 1rem;
  display: block;
  border-bottom: 1px solid var(--color-line);
  padding-bottom: 0.65rem;
}

.sms-search__empty-links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.sms-search__empty-links a {
  font-family: var(--font-display);
  font-size: 1rem;
  font-style: italic;
  font-weight: 300;
  color: var(--color-ink);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 0.35em;
}

@media (prefers-reduced-motion: no-preference) {
  .sms-search__empty-links a { transition: color 0.2s; }
}

.sms-search__empty-links a:hover { color: var(--color-ember); }

/* ── Initial state (no query yet) ───────────────────────── */
.sms-search__initial {
  padding: 3rem 0;
}

.sms-search__initial-label {
  font-family: var(--font-body);
  font-size: 0.625rem;
  font-weight: 600;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-stone);
  margin-bottom: 1rem;
  display: block;
  border-bottom: 1px solid var(--color-line);
  padding-bottom: 0.65rem;
}

.sms-search__popular {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  list-style: none;
  margin: 0;
  padding: 0;
}

.sms-search__popular a {
  font-family: var(--font-body);
  font-size: 0.75rem;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-ink);
  text-decoration: none;
  padding: 0.45em 0.9em;
  border: 1px solid var(--color-line);
  background: var(--color-cream);
  display: inline-block;
}

@media (prefers-reduced-motion: no-preference) {
  .sms-search__popular a { transition: background 0.15s, border-color 0.15s; }
}

.sms-search__popular a:hover {
  background: var(--color-sand);
  border-color: var(--color-ink);
}

/* ── Visually hidden utility ─────────────────────────────── */
.sms-sr-only {
  position: absolute;
  width: 1px; height: 1px;
  padding: 0; margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
{% endstylesheet %}

<section
  class="sms-search container"
  data-section-id="{{ section.id }}"
  data-section-type="main-search"
>

  {%- comment -%} ── Hero header ──────────────────────────── {%- endcomment -%}
  <header class="sms-search__hero">
    <span class="sms-search__eyebrow">
      {%- if search.performed and search.results_count > 0 -%}
        {{ 'general.search.results_for' | t: terms: search.terms | escape }}
      {%- elsif search.performed -%}
        {{ 'general.search.no_results' | t }}
      {%- else -%}
        {{ section.settings.eyebrow | default: 'Discover' }}
      {%- endif -%}
    </span>
    <h1 class="sms-search__headline">
      {%- if search.performed -%}
        {{ search.terms | escape | split: ' ' | join: '<em> </em>' }}
      {%- else -%}
        {{ section.settings.headline_idle | default: 'What are you<br><em>looking for?</em>' }}
      {%- endif -%}
    </h1>
  </header>

  {%- comment -%} ── Search form ──────────────────────────── {%- endcomment -%}
  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="sms-search__form-wrap"
    id="sms-search-form"
    aria-label="{{ 'general.search.search' | t }}"
  >
    <input type="hidden" name="type" value="product,article,page">

    <label class="sms-sr-only" for="sms-search-input">{{ 'general.search.search' | t }}</label>
    <input
      id="sms-search-input"
      class="sms-search__input"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ section.settings.input_placeholder | default: 'Silk, cashmere, evening…' }}"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      aria-autocomplete="list"
      aria-controls="sms-predictive"
      aria-expanded="false"
    >

    <button type="submit" class="sms-search__submit" aria-label="{{ 'general.search.search' | t }}">
      <span aria-hidden="true">{{ section.settings.submit_label | default: 'Search' }}</span>
      <svg class="sms-search__submit-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <line x1="1" y1="8" x2="14" y2="8"/>
        <polyline points="9 3 14 8 9 13"/>
      </svg>
    </button>

    {%- comment -%} Predictive dropdown ─────────────────────── {%- endcomment -%}
    <div
      id="sms-predictive"
      class="sms-search__predictive"
      role="listbox"
      aria-label="{{ 'general.search.search' | t }} suggestions"
      aria-hidden="true"
    ></div>
  </form>

  {%- comment -%} ── Results / empty / initial ────────────── {%- endcomment -%}
  {%- if search.performed -%}

    {%- if search.results_count > 0 -%}
      <div class="sms-search__meta">
        <p class="sms-search__count">
          <strong>{{ search.results_count }}</strong>
          {%- if search.results_count == 1 -%}
            &nbsp;{{ section.settings.label_result | default: 'result' }}
          {%- else -%}
            &nbsp;{{ section.settings.label_results | default: 'results' }}
          {%- endif -%}
          &nbsp;{{ 'general.search.for' | t }}
          &ldquo;{{ search.terms | escape }}&rdquo;
        </p>
      </div>

      <div class="sms-search__grid" role="list">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <div role="listitem">
              {% render 'product-card', product: item %}
            </div>
          {%- else -%}
            <a
              href="{{ item.url }}"
              class="sms-editorial-card"
              role="listitem"
            >
              <p class="sms-editorial-card__tag">
                {%- if item.object_type == 'article' -%}
                  {{ 'blogs.article.label' | t | default: 'Journal' }}
                {%- else -%}
                  {{ 'general.search.page' | t | default: 'Page' }}
                {%- endif -%}
              </p>
              <h2 class="sms-editorial-card__title">{{ item.title }}</h2>
              {%- if item.object_type == 'article' and item.excerpt_or_content != blank -%}
                <p class="sms-editorial-card__excerpt">{{ item.excerpt_or_content | strip_html }}</p>
              {%- endif -%}
              <span class="sms-editorial-card__link" aria-hidden="true">
                {{ section.settings.read_label | default: 'Read' }}
                <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                  <line x1="1" y1="8" x2="14" y2="8"/>
                  <polyline points="9 3 14 8 9 13"/>
                </svg>
              </span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- else -%}

      {%- comment -%} ── Empty state ───────────────────────── {%- endcomment -%}
      <div class="sms-search__empty" role="status" aria-live="polite">
        <h2 class="sms-search__empty-headline">
          {{ section.settings.empty_headline | default: 'Nothing found—<br>yet.' }}
        </h2>
        <p class="sms-search__empty-sub">
          {{ section.settings.empty_sub | default: 'Try different words, or explore below.' }}
        </p>

        {%- if section.settings.suggested_links != blank or section.settings.popular_searches != blank -%}
          <div>
            <span class="sms-search__empty-group-label">{{ section.settings.suggested_label | default: 'Explore' }}</span>
            <ul class="sms-search__empty-links">
              {%- for i in (1..5) -%}
                {%- assign link_url_key = 'suggested_link_' | append: i | append: '_url' -%}
                {%- assign link_label_key = 'suggested_link_' | append: i | append: '_label' -%}
                {%- assign link_url = section.settings[link_url_key] -%}
                {%- assign link_label = section.settings[link_label_key] -%}
                {%- if link_url != blank and link_label != blank -%}
                  <li>
                    <a href="{{ link_url }}">
                      <svg width="10" height="10" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true" focusable="false">
                        <line x1="1" y1="8" x2="14" y2="8"/>
                        <polyline points="9 3 14 8 9 13"/>
                      </svg>
                      {{ link_label }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>

          <div>
            <span class="sms-search__empty-group-label">{{ section.settings.popular_label | default: 'Popular searches' }}</span>
            <ul class="sms-search__popular">
              {%- assign popular_raw = section.settings.popular_searches | default: '' -%}
              {%- assign popular_terms = popular_raw | split: ',' -%}
              {%- for term in popular_terms -%}
                {%- assign t_clean = term | strip -%}
                {%- if t_clean != blank -%}
                  <li>
                    <a href="{{ routes.search_url }}?q={{ t_clean | url_encode }}&type=product,article,page">
                      {{ t_clean }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>

    {%- endif -%}

  {%- else -%}

    {%- comment -%} ── Initial / idle state ──────────────────── {%- endcomment -%}
    <div class="sms-search__initial">
      <span class="sms-search__initial-label">{{ section.settings.popular_label | default: 'Popular searches' }}</span>
      <ul class="sms-search__popular" aria-label="{{ section.settings.popular_label | default: 'Popular searches' }}">
        {%- assign popular_raw = section.settings.popular_searches | default: '' -%}
        {%- assign popular_terms = popular_raw | split: ',' -%}
        {%- for term in popular_terms -%}
          {%- assign t_clean = term | strip -%}
          {%- if t_clean != blank -%}
            <li>
              <a href="{{ routes.search_url }}?q={{ t_clean | url_encode }}&type=product,article,page">
                {{ t_clean }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

  {%- endif -%}

</section>

{% javascript %}
(function () {
  'use strict';

  var SECTION_ID = document.querySelector('[data-section-type="main-search"]').dataset.sectionId;
  var DEBOUNCE_MS = 220;
  var MIN_CHARS = 2;
  var PREDICTIVE_URL = '/search/suggest.json';

  var input = document.getElementById('sms-search-input');
  var dropdown = document.getElementById('sms-predictive');
  if (!input || !dropdown) return;

  var timer = null;
  var activeIdx = -1;
  var lastQuery = '';

  /* ── helpers ─────────────────────────────────────────────── */
  function money(cents) {
    if (cents == null) return '';
    var sym = window.Shopify && window.Shopify.currency && window.Shopify.currency.active
      ? window.Shopify.currency.active
      : 'USD';
    try {
      return new Intl.NumberFormat(document.documentElement.lang || 'en', {
        style: 'currency', currency: sym, minimumFractionDigits: 0
      }).format(cents / 100);
    } catch (e) {
      return '$' + (cents / 100).toFixed(2);
    }
  }

  function esc(str) {
    return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  /* ── open / close ────────────────────────────────────────── */
  function open() {
    dropdown.setAttribute('aria-hidden', 'false');
    input.setAttribute('aria-expanded', 'true');
  }

  function close() {
    dropdown.setAttribute('aria-hidden', 'true');
    input.setAttribute('aria-expanded', 'false');
    activeIdx = -1;
  }

  /* ── render items ────────────────────────────────────────── */
  function render(products) {
    if (!products || !products.length) { close(); return; }

    var html = '';
    for (var i = 0; i < products.length; i++) {
      var p = products[i];
      var thumb = p.featured_image && p.featured_image.url
        ? '<img class="sms-search__predictive-thumb" src="' + esc(p.featured_image.url + '?width=80') + '" alt="" loading="lazy" width="40" height="40">'
        : '<span class="sms-search__predictive-thumb" aria-hidden="true"></span>';
      var price = p.price != null ? '<span class="sms-search__predictive-price">' + esc(money(p.price)) + '</span>' : '';
      html += '<a href="' + esc(p.url) + '" class="sms-search__predictive-item" role="option" id="sms-opt-' + i + '" tabindex="-1">'
        + thumb
        + '<span><span class="sms-search__predictive-name">' + esc(p.title) + '</span>' + price + '</span>'
        + '</a>';
    }

    dropdown.innerHTML = html;
    open();
    activeIdx = -1;
  }

  /* ── fetch via suggest.json ──────────────────────────────── */
  function fetchSuggest(q) {
    var url = PREDICTIVE_URL + '?q=' + encodeURIComponent(q) + '&resources[type]=product&resources[limit]=6';

    fetch(url, { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (data) {
        if (!data) return;
        var products = data.resources && data.resources.results && data.resources.results.products;
        render(products);
      })
      .catch(function () { close(); });
  }

  /* ── keyboard navigation ─────────────────────────────────── */
  input.addEventListener('keydown', function (e) {
    var items = dropdown.querySelectorAll('.sms-search__predictive-item');
    if (!items.length) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      activeIdx = Math.min(activeIdx + 1, items.length - 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      activeIdx = Math.max(activeIdx - 1, -1);
    } else if (e.key === 'Escape') {
      close();
      return;
    } else if (e.key === 'Enter' && activeIdx >= 0) {
      e.preventDefault();
      items[activeIdx].click();
      return;
    } else {
      return;
    }

    items.forEach(function (el, idx) {
      el.setAttribute('aria-selected', idx === activeIdx ? 'true' : 'false');
    });
    input.setAttribute('aria-activedescendant', activeIdx >= 0 ? 'sms-opt-' + activeIdx : '');
  });

  /* ── input handler ───────────────────────────────────────── */
  input.addEventListener('input', function () {
    var q = input.value.trim();
    if (q === lastQuery) return;
    lastQuery = q;

    clearTimeout(timer);
    if (q.length < MIN_CHARS) { close(); return; }

    timer = setTimeout(function () { fetchSuggest(q); }, DEBOUNCE_MS);
  });

  /* ── close on outside click ──────────────────────────────── */
  document.addEventListener('click', function (e) {
    if (!input.contains(e.target) && !dropdown.contains(e.target)) close();
  });

  /* ── close on form submit ────────────────────────────────── */
  var form = document.getElementById('sms-search-form');
  if (form) form.addEventListener('submit', function () { close(); });

})();
{% endjavascript %}

{% schema %}
