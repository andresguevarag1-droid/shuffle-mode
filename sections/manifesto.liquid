{% comment %} Manifesto — Shuffle Mode Brand Statement Section {% endcomment %}

{%- liquid
  assign dark_mode   = section.settings.dark
  assign eyebrow     = section.settings.eyebrow
  assign heading     = section.settings.heading
  assign emphasis    = section.settings.emphasis
  assign body_text   = section.settings.body
  assign cta_label   = section.settings.cta_label
  assign cta_url     = section.settings.cta_url
  assign has_image   = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

<section
  id="manifesto-{{ section.id }}"
  class="sm-manifesto{% if dark_mode %} sm-manifesto--dark{% endif %}{% if has_image %} sm-manifesto--with-image{% else %} sm-manifesto--type-only{% endif %}"
  data-section-id="{{ section.id }}"
  style="
    --sm-manifesto-bg: {% if dark_mode %}var(--color-ink){% else %}var(--color-sand){% endif %};
    --sm-manifesto-fg: {% if dark_mode %}var(--color-cream){% else %}var(--color-ink){% endif %};
    --sm-manifesto-stone: {% if dark_mode %}rgba(251,249,244,.45){% else %}var(--color-stone){% endif %};
    --sm-manifesto-line: {% if dark_mode %}rgba(251,249,244,.10){% else %}var(--color-line){% endif %};
  "
>
  <div class="sm-manifesto__inner container">

    {%- if has_image -%}
    <figure class="sm-manifesto__media" aria-hidden="true">
      {{
        section.settings.image
        | image_url: width: 1400
        | image_tag:
          loading: 'lazy',
          widths: '600, 900, 1200, 1400',
          class: 'sm-manifesto__img',
          alt: eyebrow | escape
      }}
      <div class="sm-manifesto__media-veil"></div>
    </figure>
    {%- else -%}
    <div class="sm-manifesto__wordmark-bg" aria-hidden="true">
      <span class="sm-manifesto__wm-text">SM</span>
    </div>
    {%- endif -%}

    <div class="sm-manifesto__content">

      {%- if eyebrow != blank -%}
      <p class="sm-manifesto__eyebrow" data-reveal="eyebrow">
        <span class="sm-manifesto__eyebrow-inner">{{ eyebrow | escape }}</span>
      </p>
      {%- endif -%}

      {%- if heading != blank -%}
      {%- assign words = heading | split: ' ' -%}
      {%- assign emph_phrase = emphasis | downcase | strip -%}
      <h2 class="sm-manifesto__heading" data-reveal="heading" aria-label="{{ heading | escape }}">
        {%- assign remaining = heading -%}
        {%- if emph_phrase != blank and heading downcase contains emph_phrase -%}
          {%- assign before_emph = heading | split: emphasis | first -%}
          {%- assign after_emph  = heading | split: emphasis | last -%}
          {%- if before_emph != heading -%}
            {%- assign lines_before = before_emph | split: ' ' -%}
            {%- for word in lines_before -%}
              {%- if word != '' -%}
                <span class="sm-manifesto__word" aria-hidden="true">{{ word }}</span>{{ ' ' }}
              {%- endif -%}
            {%- endfor -%}
            <em class="sm-manifesto__emphasis" aria-hidden="true">{{ emphasis }}</em>{{ ' ' }}
            {%- assign lines_after = after_emph | strip | split: ' ' -%}
            {%- for word in lines_after -%}
              {%- if word != '' -%}
                <span class="sm-manifesto__word" aria-hidden="true">{{ word }}</span>{{ ' ' }}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for word in words -%}
              <span class="sm-manifesto__word" aria-hidden="true">{{ word }}</span>{{ ' ' }}
            {%- endfor -%}
          {%- endif -%}
        {%- else -%}
          {%- for word in words -%}
            <span class="sm-manifesto__word" aria-hidden="true">{{ word }}</span>{{ ' ' }}
          {%- endfor -%}
        {%- endif -%}
      </h2>
      {%- endif -%}

      <div class="sm-manifesto__divider" data-reveal="divider" aria-hidden="true"></div>

      {%- if body_text != blank -%}
      <div class="sm-manifesto__body" data-reveal="body">
        {{ body_text }}
      </div>
      {%- endif -%}

      {%- if cta_label != blank -%}
      <div class="sm-manifesto__cta-wrap" data-reveal="cta">
        <a
          href="{{ cta_url | default: '#' }}"
          class="sm-manifesto__cta"
          {% if cta_url == blank %}aria-disabled="true"{% endif %}
        >
          <span class="sm-manifesto__cta-text">{{ cta_label | escape }}</span>
          <span class="sm-manifesto__cta-arrow" aria-hidden="true">
            <svg width="18" height="10" viewBox="0 0 18 10" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 5h16M12 1l5 4-5 4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      </div>
      {%- endif -%}

    </div><!-- /.sm-manifesto__content -->
  </div><!-- /.sm-manifesto__inner -->
</section>

{% stylesheet %}

/* ─── MANIFESTO ROOT ─── */
.sm-manifesto {
  position: relative;
  background: var(--sm-manifesto-bg);
  color: var(--sm-manifesto-fg);
  overflow: hidden;
  padding: clamp(4rem, 8vw, 7rem) 0;
  transition: background 0.4s ease;
}

/* ─── INNER ─── */
.sm-manifesto__inner {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 0;
  /* Prevent grid children from blowing out their column */
  min-width: 0;
}

/* ─── WITH-IMAGE layout ─── */
.sm-manifesto--with-image .sm-manifesto__inner {
  grid-template-columns: 1fr;
  grid-template-rows: auto auto;
}

@media (min-width: 900px) {
  .sm-manifesto--with-image .sm-manifesto__inner {
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "media content";
    align-items: center;
    gap: 80px;
  }
  .sm-manifesto--with-image .sm-manifesto__media {
    grid-area: media;
    min-width: 0;
  }
  .sm-manifesto--with-image .sm-manifesto__content {
    grid-area: content;
    min-width: 0;
  }
}

/* ─── BACKGROUND WORDMARK (type-only) ─── */
.sm-manifesto__wordmark-bg {
  position: absolute;
  inset: 0;
  z-index: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  overflow: hidden;
  user-select: none;
}

.sm-manifesto__wm-text {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(240px, 38vw, 520px);
  line-height: 0.85;
  letter-spacing: -0.04em;
  color: transparent;
  -webkit-text-stroke: 1px var(--sm-manifesto-line);
  opacity: 0.5;
  display: block;
  transform: translateY(4%);
}

/* ─── IMAGE / MEDIA ─── */
.sm-manifesto__media {
  position: relative;
  margin: 0 0 48px;
  aspect-ratio: 3 / 4;
  border-radius: 2px;
  overflow: hidden;
}

@media (min-width: 900px) {
  .sm-manifesto__media {
    margin: 0;
    aspect-ratio: 4 / 5;
  }
}

.sm-manifesto__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.sm-manifesto__media-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    transparent 55%,
    rgba(22, 19, 15, 0.25) 100%
  );
  pointer-events: none;
}

/* ─── CONTENT ─── */
.sm-manifesto__content {
  position: relative;
  z-index: 2;
  max-width: 680px;
  /* Prevent the column from overflowing when heading words are very long */
  min-width: 0;
  overflow-wrap: break-word;
  word-break: break-word;
}

.sm-manifesto--type-only .sm-manifesto__content {
  margin: 0 auto;
  text-align: center;
  max-width: 780px;
}

/* ─── EYEBROW ─── */
.sm-manifesto__eyebrow {
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-ember);
  margin: 0 0 28px;
  overflow: hidden;
}

.sm-manifesto__eyebrow-inner {
  display: inline-block;
  transform: translateY(100%);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.7s ease;
}

/* ─── HEADING ─── */
.sm-manifesto__heading {
  font-family: var(--font-display);
  font-size: clamp(44px, 7.5vw, 96px);
  font-weight: 300;
  line-height: 1.02;
  letter-spacing: -0.025em;
  margin: 0 0 40px;
  color: var(--sm-manifesto-fg);
}

.sm-manifesto__word {
  display: inline-block;
  transform: translateY(60px);
  opacity: 0;
  transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.6s ease;
}

.sm-manifesto__emphasis {
  font-style: italic;
  color: var(--color-ember);
  display: inline-block;
  transform: translateY(60px);
  opacity: 0;
  transition: transform 0.75s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.6s ease;
}

/* ─── DIVIDER ─── */
.sm-manifesto__divider {
  width: 0;
  height: 1px;
  background: var(--sm-manifesto-line);
  margin: 0 0 36px;
  transition: width 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
}

.sm-manifesto--type-only .sm-manifesto__divider {
  margin: 0 auto 36px;
}

/* ─── BODY ─── */
.sm-manifesto__body {
  font-family: var(--font-body);
  font-size: clamp(16px, 1.8vw, 18px);
  line-height: 1.75;
  color: var(--sm-manifesto-stone);
  margin: 0 0 44px;
  transform: translateY(24px);
  opacity: 0;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.8s ease;
}

.sm-manifesto__body p { margin: 0 0 1em; }
.sm-manifesto__body p:last-child { margin-bottom: 0; }

/* ─── CTA ─── */
.sm-manifesto__cta-wrap {
  transform: translateY(16px);
  opacity: 0;
  transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
              opacity 0.7s ease;
}

.sm-manifesto__cta {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-body);
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  color: var(--sm-manifesto-fg);
  border-bottom: 1px solid var(--color-ember);
  padding-bottom: 6px;
  transition: color 0.25s ease, gap 0.3s ease;
}

.sm-manifesto__cta:hover {
  color: var(--color-ember);
  gap: 18px;
}

.sm-manifesto__cta-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  transition: transform 0.3s ease;
}

.sm-manifesto__cta:hover .sm-manifesto__cta-arrow {
  transform: translateX(4px);
}

/* ─── REVEALED STATE (JS adds .is-revealed) ─── */
.sm-manifesto__eyebrow.is-revealed .sm-manifesto__eyebrow-inner {
  transform: translateY(0);
  opacity: 1;
}

.sm-manifesto__heading.is-revealed .sm-manifesto__word,
.sm-manifesto__heading.is-revealed .sm-manifesto__emphasis {
  transform: translateY(0);
  opacity: 1;
}

.sm-manifesto__divider.is-revealed {
  width: 100%;
}

.sm-manifesto--type-only .sm-manifesto__divider.is-revealed {
  width: 64px;
}

.sm-manifesto__body.is-revealed,
.sm-manifesto__cta-wrap.is-revealed {
  transform: translateY(0);
  opacity: 1;
}

/* ─── REDUCED MOTION: show everything immediately ─── */
@media (prefers-reduced-motion: reduce) {
  .sm-manifesto__eyebrow-inner,
  .sm-manifesto__word,
  .sm-manifesto__emphasis,
  .sm-manifesto__divider,
  .sm-manifesto__body,
  .sm-manifesto__cta-wrap {
    transform: none !important;
    opacity: 1 !important;
    width: auto !important;
    transition: none !important;
  }
  .sm-manifesto__divider {
    width: 100% !important;
  }
  .sm-manifesto--type-only .sm-manifesto__divider {
    width: 64px !important;
  }
}

/* ─── LARGE SCREENS — clamp already handles this, block retained for reference ─── */

/* ─── TABLET (768–1024) ─── */
@media (min-width: 768px) and (max-width: 1024px) {
  .sm-manifesto__heading {
    font-size: clamp(36px, 6vw, 64px);
  }
  .sm-manifesto__content {
    max-width: 100%;
  }
}

/* ─── MOBILE (≤767px) ─── */
@media (max-width: 767px) {
  .sm-manifesto {
    padding: clamp(2.5rem, 8vw, 4rem) 0;
    /* Belt-and-suspenders horizontal overflow guard */
    overflow-x: hidden;
  }

  .sm-manifesto__inner {
    /* Single-column; children must not exceed viewport */
    overflow: hidden;
  }

  .sm-manifesto__heading {
    /* Never let large editorial type overflow 320px viewport */
    font-size: clamp(2rem, 10vw, 44px);
    overflow-wrap: break-word;
    word-break: break-word;
    margin-bottom: 28px;
    max-width: 100%;
  }

  /* Word-reveal spans must wrap like inline text — they already are
     inline-block; ensure no whitespace-nowrap leak */
  .sm-manifesto__word,
  .sm-manifesto__emphasis {
    white-space: normal;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  .sm-manifesto__content {
    max-width: 100%;
  }

  .sm-manifesto--type-only .sm-manifesto__content {
    text-align: center;
  }

  .sm-manifesto__eyebrow {
    margin-bottom: 20px;
  }

  .sm-manifesto__body {
    font-size: clamp(15px, 4vw, 17px);
    margin-bottom: 32px;
    max-width: 100%;
  }

  .sm-manifesto__media {
    margin-bottom: 32px;
  }

  /* CTA: ensure min tap target height */
  .sm-manifesto__cta {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
}

/* ─── SMALL PHONE (≤480px) ─── */
@media (max-width: 480px) {
  .sm-manifesto__heading {
    font-size: clamp(1.875rem, 11vw, 2.5rem);
    line-height: 1.06;
    margin-bottom: 24px;
  }

  .sm-manifesto__eyebrow {
    font-size: 0.625rem;
    margin-bottom: 16px;
  }

  .sm-manifesto__body {
    font-size: clamp(14px, 4.2vw, 16px);
    line-height: 1.7;
  }

  .sm-manifesto__cta {
    /* Ensure tap target ≥44px */
    min-height: 44px;
    padding-bottom: 8px;
  }
}

/* ─── TINY PHONE (≤380px — SE / mini) ─── */
@media (max-width: 380px) {
  .sm-manifesto {
    padding: 2rem 0;
  }

  .sm-manifesto__heading {
    font-size: clamp(1.625rem, 11.5vw, 2rem);
    letter-spacing: -0.02em;
  }

  .sm-manifesto__body {
    font-size: 14px;
    margin-bottom: 28px;
  }

  /* Background wordmark — at 320px it can cause horizontal scroll */
  .sm-manifesto__wm-text {
    font-size: clamp(160px, 52vw, 260px);
  }
}

{% endstylesheet %}

{% javascript %}

(function () {
  'use strict';

  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initManifesto(section) {
    // If reduced motion, ensure everything is visible and bail
    if (prefersReduced) {
      section.querySelectorAll('[data-reveal]').forEach(function (el) {
        el.classList.add('is-revealed');
      });
      return;
    }

    var revealEls = section.querySelectorAll('[data-reveal]');
    if (!revealEls.length) return;

    var wordEls = section.querySelectorAll('.sm-manifesto__word, .sm-manifesto__emphasis');

    // Stagger word animations via CSS custom property
    wordEls.forEach(function (word, i) {
      word.style.transitionDelay = (0.04 * i + 0.15) + 's';
    });

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;

          var el = entry.target;
          var type = el.getAttribute('data-reveal');

          if (type === 'eyebrow') {
            el.classList.add('is-revealed');
          } else if (type === 'heading') {
            // Small delay after eyebrow
            setTimeout(function () {
              el.classList.add('is-revealed');
            }, 120);
          } else if (type === 'divider') {
            setTimeout(function () {
              el.classList.add('is-revealed');
            }, 300);
          } else if (type === 'body') {
            setTimeout(function () {
              el.classList.add('is-revealed');
            }, 480);
          } else if (type === 'cta') {
            setTimeout(function () {
              el.classList.add('is-revealed');
            }, 620);
          } else {
            el.classList.add('is-revealed');
          }

          observer.unobserve(el);
        });
      },
      {
        threshold: 0.15,
        rootMargin: '0px 0px -60px 0px'
      }
    );

    revealEls.forEach(function (el) {
      observer.observe(el);
    });
  }

  function init() {
    var sections = document.querySelectorAll('.sm-manifesto');
    sections.forEach(initManifesto);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  // Shopify theme editor live reload
  document.addEventListener('shopify:section:load', function (e) {
    var section = e.target.querySelector('.sm-manifesto');
    if (section) initManifesto(section);
  });

  document.addEventListener('shopify:section:unload', function () {
    // Observer is scoped to the section — GC handles cleanup
  });

})();

{% endjavascript %}

{% schema %}
{
  "name": "Manifesto",
  "tag": "section",
  "class": "sm-manifesto-section",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark variant (ink background)",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Boston — Weekly Drops"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fewer pieces. More you.",
      "info": "The big statement. Keep it short and bold."
    },
    {
      "type": "text",
      "id": "emphasis",
      "label": "Emphasis phrase",
      "default": "More you.",
      "info": "A phrase from the heading that will render in italic ember. Must match exactly."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Philosophy",
      "default": "<p>You don't dress for the occasion — you dress for the mood. Every week, a small, deliberate collection lands. No restocks. No markdowns. No pressure to keep up. Just pieces that feel like you, right now. A wardrobe that shifts with your mood, not the calendar.</p><p>Designed in Boston. Dropped on Sundays. Gone when they're gone.</p>"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop this week's drop"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Supporting Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Portrait orientation works best (3:4 or 4:5). Leave empty for a bold type-only layout."
    }
  ],
  "presets": [
    {
      "name": "Manifesto",
      "settings": {
        "dark": true,
        "eyebrow": "Boston — Weekly Drops",
        "heading": "Fewer pieces. More you.",
        "emphasis": "More you.",
        "body": "<p>You don't dress for the occasion — you dress for the mood. Every week, a small, deliberate collection lands. No restocks. No markdowns. No pressure to keep up. Just pieces that feel like you, right now. A wardrobe that shifts with your mood, not the calendar.</p><p>Designed in Boston. Dropped on Sundays. Gone when they're gone.</p>",
        "cta_label": "Shop this week's drop",
        "cta_url": ""
      }
    }
  ]
}
{% endschema %}
