<section class="container section">
  <h1 class="section__title">Collections</h1>
  <div class="product-grid" style="margin-top:3rem;">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="card">
        <div class="card__media editorial-frame">
          {%- if collection.featured_image -%}
            <img src="{{ collection.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
          {%- endif -%}
        </div>
        <div class="card__info"><div class="card__name">{{ collection.title }}</div></div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}
