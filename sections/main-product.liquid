{% javascript %}
(function () {
  'use strict';

  /* ── Gallery ───────────────────────────────── */
  function initGallery(root) {
    var gallery = root.querySelector('[data-gallery]');
    if (!gallery) return;
    var mainImg = gallery.querySelector('[data-main]');
    var thumbs  = gallery.querySelectorAll('[data-thumb]');
    if (!mainImg || !thumbs.length) return;

    function activateThumb(btn) {
      thumbs.forEach(function (t) { t.classList.remove('is-active'); });
      btn.classList.add('is-active');

      var full = btn.getAttribute('data-full');
      if (!full || full === mainImg.getAttribute('src')) return;

      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        mainImg.setAttribute('src', full);
      } else {
        mainImg.classList.add('pdp-fade-out');
        setTimeout(function () {
          mainImg.setAttribute('src', full);
          mainImg.classList.remove('pdp-fade-out');
          mainImg.classList.add('pdp-fade-in');
          setTimeout(function () { mainImg.classList.remove('pdp-fade-in'); }, 280);
        }, 180);
      }
    }

    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () { activateThumb(btn); });
    });

    /* External variant-image swap hook */
    root.addEventListener('pdp:image-change', function (e) {
      if (!e.detail || !e.detail.src) return;
      var matchThumb = null;
      thumbs.forEach(function (t) {
        if (t.getAttribute('data-full') === e.detail.src) matchThumb = t;
      });
      if (matchThumb) {
        activateThumb(matchThumb);
      } else {
        mainImg.setAttribute('src', e.detail.src);
      }
    });
  }

  /* ── Single-open accordion ─────────────────── */
  function initAccordions(root) {
    var container = root.querySelector('[data-accordions]');
    if (!container) return;
    var items = container.querySelectorAll('details.pdp-accordion');

    items.forEach(function (detail) {
      detail.addEventListener('toggle', function () {
        if (detail.open) {
          items.forEach(function (other) {
            if (other !== detail && other.open) other.removeAttribute('open');
          });
        }
      });
    });
  }

  /* ── Init on DOMContentLoaded ──────────────── */
  function init() {
    var root = document.querySelector('[data-product]');
    if (!root) return;
    initGallery(root);
    initAccordions(root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
{% endjavascript %}

