{%- assign collection = collections[section.settings.collection] -%}
<section id="drop" class="container section">
  <div class="section__head reveal">
    <div>
      <span class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</span>
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="section__head-meta">
      {%- if collection != blank and section.settings.show_count -%}
        <p class="card__cat">{{ collection.products_count }} pieces in this drop</p>
      {%- endif -%}
      {%- if section.settings.note != blank -%}
        <p class="card__cat"><span class="text-ember">●</span> {{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="product-grid product-grid--4">
    {%- if collection != blank and collection.products.size > 0 -%}
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..section.settings.products_to_show) -%}
        <div class="card">
          <div class="card__media"><div class="card__ph"><span>{{ shop.name }}</span></div></div>
          <div class="card__info"><div class="card__text"><span class="card__name">Connect a collection</span><span class="card__cat">Editor → Featured drop</span></div></div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if section.settings.link_url != blank -%}
    <div class="center mt-12">
      <a href="{{ section.settings.link_url }}" class="btn btn--outline">{{ section.settings.link_label }} →</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured drop",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Drop 01" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "This week's drop" },
    { "type": "text", "id": "note", "label": "Note (scarcity)", "default": "Restocks are rare" },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View full drop" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "Featured drop" }]
}
{% endschema %}
