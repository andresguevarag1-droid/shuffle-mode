{% stylesheet %}
/* In-page anchor target that clears the sticky header */
.smrail-anchor { display: block; height: 0; scroll-margin-top: 6rem; }
/* ═══════════════════════════════════════════════════════════
   PRODUCT RAIL — Shuffle Mode
   Horizontal-scroll + grid product section.
   Classes: smrail-*   Colors: global CSS vars only.
   Card internals (.card) are untouched — only the shell,
   header, scroll container, and arrows are styled here.
   ═══════════════════════════════════════════════════════════ */

/* ── Root ─────────────────────────────────────────────────── */
.smrail-root {
  padding: clamp(3.5rem, 7vw, 6rem) 0;
  background: var(--color-bone);
  overflow: hidden;
}

.smrail-root--cream {
  background: var(--color-cream);
}

/* ── Header ───────────────────────────────────────────────── */
.smrail-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 1.5rem;
  margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
}

.smrail-header__left {
  flex: 1;
  min-width: 0;
}

.smrail-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: .5rem .75rem;
  margin-bottom: .6rem;
}

.smrail-eyebrow {
  display: inline-block;
  font-family: var(--font-body);
  font-size: .625rem;
  font-weight: 600;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--color-stone);
  line-height: 1;
}

.smrail-badge {
  display: inline-flex;
  align-items: center;
  gap: .3em;
  font-family: var(--font-body);
  font-size: .625rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--color-ember);
  background: rgba(194, 80, 46, .08);
  border: 1px solid rgba(194, 80, 46, .22);
  border-radius: 2em;
  padding: .3em .8em .28em;
  line-height: 1;
  white-space: nowrap;
}

.smrail-heading {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4.5vw, 3.5rem);
  font-weight: 300;
  font-style: italic;
  line-height: 1.05;
  color: var(--color-ink);
  margin: 0 0 .5rem;
  letter-spacing: -.02em;
}

.smrail-subheading {
  font-family: var(--font-body);
  font-size: .875rem;
  font-weight: 400;
  color: var(--color-stone);
  margin: 0;
  line-height: 1.5;
  max-width: 42ch;
}

/* ── View-all link ────────────────────────────────────────── */
.smrail-viewall {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: .5em;
  font-family: var(--font-body);
  font-size: .6875rem;
  font-weight: 500;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--color-ink);
  text-decoration: none;
  border-bottom: 1px solid var(--color-ink);
  padding-bottom: .15em;
  transition: color .25s ease, border-color .25s ease;
  white-space: nowrap;
  align-self: flex-end;
  margin-bottom: .6rem;
}

.smrail-viewall:hover,
.smrail-viewall:focus-visible {
  color: var(--color-ember);
  border-color: var(--color-ember);
}

.smrail-viewall:focus-visible {
  outline: 2px solid var(--color-ember);
  outline-offset: 3px;
  border-radius: 1px;
}

.smrail-viewall__arrow {
  display: inline-block;
  transition: transform .3s cubic-bezier(.25,.46,.45,.94);
}

.smrail-viewall:hover .smrail-viewall__arrow,
.smrail-viewall:focus-visible .smrail-viewall__arrow {
  transform: translateX(4px);
}

@media (prefers-reduced-motion: reduce) {
  .smrail-viewall__arrow,
  .smrail-viewall {
    transition: none;
  }
}

/* ── Scroll wrapper (rail layout) ────────────────────────── */
.smrail-scroll-outer {
  position: relative;
}

/* fade-edge affordances */
.smrail-scroll-outer::before,
.smrail-scroll-outer::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: clamp(2rem, 4vw, 4rem);
  pointer-events: none;
  z-index: 2;
  opacity: 0;
  transition: opacity .3s ease;
}

@media (prefers-reduced-motion: reduce) {
  .smrail-scroll-outer::before,
  .smrail-scroll-outer::after {
    transition: none;
  }
}

.smrail-scroll-outer::before {
  left: 0;
  background: linear-gradient(to right, var(--smrail-bg, var(--color-bone)), transparent);
}

.smrail-scroll-outer::after {
  right: 0;
  background: linear-gradient(to left, var(--smrail-bg, var(--color-bone)), transparent);
}

.smrail-scroll-outer.smrail--can-scroll-left::before  { opacity: 1; }
.smrail-scroll-outer.smrail--can-scroll-right::after  { opacity: 1; }

/* the actual scrolling track */
.smrail-track {
  display: flex;
  gap: var(--smrail-gap, 1.25rem);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: .25rem; /* breathing room for focus rings */
  list-style: none;
  margin: 0;
  padding-left: 0;
  padding-right: 0;
}

.smrail-track::-webkit-scrollbar {
  display: none;
}

/* card slot */
.smrail-item {
  flex: 0 0 var(--smrail-item-w, 42vw);
  scroll-snap-align: start;
  min-width: 0;
}

@media (min-width: 540px) {
  .smrail-item {
    flex-basis: var(--smrail-item-w-sm, 32vw);
  }
}

@media (min-width: 900px) {
  .smrail-item {
    flex-basis: var(--smrail-item-w-md, 23vw);
  }
}

@media (min-width: 1280px) {
  .smrail-item {
    flex-basis: var(--smrail-item-w-lg, 20vw);
  }
}

/* ── Arrow buttons ────────────────────────────────────────── */
.smrail-arrow {
  position: absolute;
  top: 50%;
  /* base transform baked in; hover only changes the scale component */
  transform: translateY(-50%);
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  background: var(--color-cream);
  border: 1px solid var(--color-line);
  color: var(--color-ink);
  cursor: pointer;
  box-shadow: 0 2px 12px rgba(22,19,15,.09);
  transition: background .2s ease, box-shadow .2s ease, opacity .2s ease, transform .2s ease;
  opacity: 0;
  pointer-events: none;
}

.smrail-arrow svg {
  display: block;
  width: 1rem;
  height: 1rem;
  flex-shrink: 0;
}

.smrail-arrow--prev { left: .75rem; }
.smrail-arrow--next { right: .75rem; }

.smrail-arrow:hover,
.smrail-arrow:focus-visible {
  background: var(--color-ink);
  color: var(--color-cream);
  box-shadow: 0 4px 20px rgba(22,19,15,.18);
  transform: translateY(-50%) scale(1.06);
}

.smrail-arrow:focus-visible {
  outline: 2px solid var(--color-ember);
  outline-offset: 2px;
}

.smrail-arrow:active {
  transform: translateY(-50%) scale(.97);
}

/* Show arrows on hover-capable devices (desktop) */
@media (hover: hover) {
  .smrail-scroll-outer:hover .smrail-arrow,
  .smrail-scroll-outer:focus-within .smrail-arrow {
    opacity: 1;
    pointer-events: auto;
  }

  .smrail-arrow.smrail-arrow--hidden {
    opacity: 0 !important;
    pointer-events: none !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .smrail-arrow {
    transition: none;
  }
}

/* ── Grid layout ──────────────────────────────────────────── */
.smrail-grid {
  display: grid;
  gap: var(--smrail-gap, 1.25rem);
  grid-template-columns: repeat(2, 1fr);
  list-style: none;
  margin: 0;
  padding: 0;
}

@media (min-width: 540px) {
  .smrail-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 900px) {
  .smrail-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1280px) {
  .smrail-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* grid items are normal flow */
.smrail-grid .smrail-item {
  flex: none;
  width: auto;
  scroll-snap-align: none;
}

/* ── Divider line under header ────────────────────────────── */
.smrail-rule {
  height: 1px;
  background: var(--color-line);
  margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
}

/* ── Empty / editorial placeholder ───────────────────────── */
.smrail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: clamp(3rem, 8vw, 6rem) 1.5rem;
  border: 1px dashed var(--color-line);
  border-radius: .25rem;
  gap: 1rem;
}

.smrail-empty__wordmark {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 300;
  font-style: italic;
  color: var(--color-stone);
  letter-spacing: -.02em;
  opacity: .5;
  margin: 0;
}

.smrail-empty__body {
  font-family: var(--font-body);
  font-size: .8125rem;
  color: var(--color-stone);
  line-height: 1.6;
  max-width: 32ch;
  margin: 0;
}

/* ── Responsive header ────────────────────────────────────── */
@media (max-width: 640px) {
  .smrail-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .smrail-viewall {
    align-self: flex-start;
    margin-bottom: 0;
  }
}
{% endstylesheet %}

{%- liquid
  assign s           = section.settings
  assign coll        = collections[section.settings.collection]
  assign limit       = s.products_to_show | default: 8
  assign sort_by     = s.sort | default: 'default'
  assign layout_mode = s.layout | default: 'rail'
-%}

{%- if s.anchor_id != blank -%}
  <span id="{{ s.anchor_id | handle }}" class="smrail-anchor" aria-hidden="true"></span>
{%- endif -%}
<section
  class="smrail-root"
  id="smrail-{{ section.id }}"
  aria-labelledby="smrail-heading-{{ section.id }}"
  style="--smrail-gap:1.25rem;--smrail-bg:var(--color-bone);--smrail-item-w:42vw;--smrail-item-w-sm:30vw;--smrail-item-w-md:22vw;--smrail-item-w-lg:19vw;"
>
  <div class="container">

    {%- comment %} ── HEADER ─────────────────────────────────── {%- endcomment %}
    <header class="smrail-header">
      <div class="smrail-header__left">
        <div class="smrail-meta">
          {%- if s.eyebrow != blank -%}
            <span class="smrail-eyebrow">{{ s.eyebrow }}</span>
          {%- endif -%}
          {%- if s.badge_text != blank -%}
            <span class="smrail-badge" aria-label="{{ s.badge_text | escape }}">{{ s.badge_text }}</span>
          {%- endif -%}
        </div>
        {%- if s.heading != blank -%}
          <h2 class="smrail-heading" id="smrail-heading-{{ section.id }}">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.subheading != blank -%}
          <p class="smrail-subheading">{{ s.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if s.link_label != blank and s.link_url != blank -%}
        <a
          href="{{ s.link_url }}"
          class="smrail-viewall"
          aria-label="{{ s.link_label | escape }} — {{ s.heading | escape }}"
        >
          {{ s.link_label }}
          <span class="smrail-viewall__arrow" aria-hidden="true">&#8594;</span>
        </a>
      {%- endif -%}
    </header>

    <div class="smrail-rule" aria-hidden="true"></div>

    {%- comment %} ── PRODUCT OUTPUT ─────────────────────────── {%- endcomment %}

    {%- if coll != blank and coll.products.size > 0 -%}

      {%- if layout_mode == 'rail' -%}

        {%- comment %} RAIL — horizontal scroll with snap + JS arrows {%- endcomment %}
        <div
          class="smrail-scroll-outer"
          data-smrail-outer
        >
          {%- comment %} Prev arrow — shown/hidden by JS on hover-capable devices {%- endcomment %}
          <button
            type="button"
            class="smrail-arrow smrail-arrow--prev"
            data-smrail-prev
            aria-label="Scroll left"
            hidden
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M10 3L5 8l5 5"/>
            </svg>
          </button>

          <ul
            class="smrail-track"
            role="list"
            aria-label="{{ s.heading | default: 'Products' | escape }}"
            data-smrail-track
          >
            {%- if sort_by == 'low-stock' -%}
              {%- comment -%}
                Low-stock sort: two-pass iteration.
                Pass 1 — products where at least one tracked variant has inventory ≤ 5.
                Pass 2 — remaining available products to pad the rail to `limit`.
                Requires inventory tracking enabled on products for best results.
              {%- endcomment -%}
              {%- assign rendered_count = 0 -%}
              {%- for product in coll.products -%}
                {%- if rendered_count >= limit -%}{%- break -%}{%- endif -%}
                {%- if product.available -%}
                  {%- assign is_low = false -%}
                  {%- for v in product.variants -%}
                    {%- if v.available and v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 5 -%}
                      {%- assign is_low = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if is_low -%}
                    <li class="smrail-item" role="listitem">
                      {%- render 'product-card', product: product -%}
                    </li>
                    {%- assign rendered_count = rendered_count | plus: 1 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {%- for product in coll.products -%}
                {%- if rendered_count >= limit -%}{%- break -%}{%- endif -%}
                {%- if product.available -%}
                  {%- assign is_low_pad = false -%}
                  {%- for v in product.variants -%}
                    {%- if v.available and v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 5 -%}
                      {%- assign is_low_pad = true -%}
                    {%- endif -%}
                  {%- endfor -%}
                  {%- unless is_low_pad -%}
                    <li class="smrail-item" role="listitem">
                      {%- render 'product-card', product: product -%}
                    </li>
                    {%- assign rendered_count = rendered_count | plus: 1 -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- comment -%}
                default / best-selling / newest:
                Relies on the collection's storefront sort order set in Shopify admin.
                For best-selling: set the collection sort to "Best selling" in admin.
                For newest: set the collection sort to "Date, new to old" in admin.
              {%- endcomment -%}
              {%- for product in coll.products limit: limit -%}
                <li class="smrail-item" role="listitem">
                  {%- render 'product-card', product: product -%}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>

          {%- comment %} Next arrow {%- endcomment %}
          <button
            type="button"
            class="smrail-arrow smrail-arrow--next"
            data-smrail-next
            aria-label="Scroll right"
            hidden
          >
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M6 3l5 5-5 5"/>
            </svg>
          </button>
        </div>

      {%- else -%}

        {%- comment %} GRID — responsive CSS grid {%- endcomment %}
        <ul class="smrail-grid" role="list" aria-label="{{ s.heading | default: 'Products' | escape }}">
          {%- if sort_by == 'low-stock' -%}
            {%- assign rendered_count = 0 -%}
            {%- for product in coll.products -%}
              {%- if rendered_count >= limit -%}{%- break -%}{%- endif -%}
              {%- if product.available -%}
                {%- assign is_low = false -%}
                {%- for v in product.variants -%}
                  {%- if v.available and v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 5 -%}
                    {%- assign is_low = true -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- if is_low -%}
                  <li class="smrail-item" role="listitem">
                    {%- render 'product-card', product: product -%}
                  </li>
                  {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- for product in coll.products -%}
              {%- if rendered_count >= limit -%}{%- break -%}{%- endif -%}
              {%- if product.available -%}
                {%- assign is_low_pad = false -%}
                {%- for v in product.variants -%}
                  {%- if v.available and v.inventory_management != blank and v.inventory_quantity > 0 and v.inventory_quantity <= 5 -%}
                    {%- assign is_low_pad = true -%}
                  {%- endif -%}
                {%- endfor -%}
                {%- unless is_low_pad -%}
                  <li class="smrail-item" role="listitem">
                    {%- render 'product-card', product: product -%}
                  </li>
                  {%- assign rendered_count = rendered_count | plus: 1 -%}
                {%- endunless -%}
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- for product in coll.products limit: limit -%}
              <li class="smrail-item" role="listitem">
                {%- render 'product-card', product: product -%}
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>

      {%- endif -%}

    {%- else -%}

      {%- comment %} ── EMPTY / EDITORIAL PLACEHOLDER ──────────── {%- endcomment %}
      <div class="smrail-empty" role="status" aria-live="polite">
        <p class="smrail-empty__wordmark" aria-hidden="true">{{ shop.name }}</p>
        <p class="smrail-empty__body">
          {%- if coll == blank -%}
            Connect a collection in the section settings to display products here.
          {%- else -%}
            No products are currently available in this collection. Check back soon.
          {%- endif -%}
        </p>
      </div>

    {%- endif -%}

  </div>
</section>

{% javascript %}
(function () {
  'use strict';

  /* ── Arrow-button scroll controller ──────────────────────── */
  function initRail(outerEl) {
    var track   = outerEl.querySelector('[data-smrail-track]');
    var btnPrev = outerEl.querySelector('[data-smrail-prev]');
    var btnNext = outerEl.querySelector('[data-smrail-next]');

    if (!track) return;

    /* Only reveal arrow buttons on pointer-fine (hover-capable) devices.
       Touch users rely on native swipe — arrows stay hidden for them. */
    var prefersHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (prefersHover && btnPrev && btnNext) {
      btnPrev.removeAttribute('hidden');
      btnNext.removeAttribute('hidden');
    }

    function getScrollAmount() {
      return Math.round(track.clientWidth * 0.78);
    }

    function updateArrows() {
      var scrollLeft = track.scrollLeft;
      var maxScroll  = track.scrollWidth - track.clientWidth;

      var canLeft  = scrollLeft > 4;
      var canRight = scrollLeft < maxScroll - 4;

      if (btnPrev) {
        btnPrev.classList.toggle('smrail-arrow--hidden', !canLeft);
        btnPrev.setAttribute('aria-disabled', canLeft ? 'false' : 'true');
      }
      if (btnNext) {
        btnNext.classList.toggle('smrail-arrow--hidden', !canRight);
        btnNext.setAttribute('aria-disabled', canRight ? 'false' : 'true');
      }

      outerEl.classList.toggle('smrail--can-scroll-left',  canLeft);
      outerEl.classList.toggle('smrail--can-scroll-right', canRight);
    }

    function doScroll(delta) {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({
        left: delta,
        behavior: reduced ? 'instant' : 'smooth'
      });
    }

    if (btnPrev) {
      btnPrev.addEventListener('click', function () { doScroll(-getScrollAmount()); });
    }
    if (btnNext) {
      btnNext.addEventListener('click', function () { doScroll(getScrollAmount()); });
    }

    var scrollRaf;
    track.addEventListener('scroll', function () {
      if (scrollRaf) return;
      scrollRaf = requestAnimationFrame(function () {
        updateArrows();
        scrollRaf = null;
      });
    }, { passive: true });

    /* Re-evaluate on resize */
    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateArrows, 120);
    }, { passive: true });

    updateArrows();
  }

  function boot() {
    var rails = document.querySelectorAll('[data-smrail-outer]');
    for (var i = 0; i < rails.length; i++) {
      initRail(rails[i]);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Product rail",
  "tag": "section",
  "class": "smrail-section",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "This week",
      "info": "Small uppercase label above the heading."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best Sellers"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "info": "Optional descriptive line below the heading."
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge",
      "info": "Short tag shown inline with the eyebrow, e.g. \"🔥 Trending\" or \"Almost gone\". Leave blank to hide."
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Sort order",
      "options": [
        {
          "value": "default",
          "label": "Collection default"
        },
        {
          "value": "best-selling",
          "label": "Best selling"
        },
        {
          "value": "newest",
          "label": "Newest first"
        },
        {
          "value": "low-stock",
          "label": "Low stock first"
        }
      ],
      "default": "default",
      "info": "\"Best selling\" and \"Newest first\" use the collection's storefront sort order — set it to match in Shopify admin (Products › Collections › [collection] › Sort). \"Low stock first\" surfaces products with ≤5 units tracked inventory, then pads with other available products."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "rail",
          "label": "Rail — horizontal scroll"
        },
