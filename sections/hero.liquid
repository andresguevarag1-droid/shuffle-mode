<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content reveal">
      <span class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</span>
      <h1 class="hero__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h1>
      <p class="hero__sub">{{ section.settings.subheading }}</p>

      <div class="hero__cta">
        {%- if section.settings.cta_url != blank -%}
          <a href="{{ section.settings.cta_url }}" class="btn btn--primary">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_url != blank -%}
          <a href="{{ section.settings.cta2_url }}" class="link-arrow">{{ section.settings.cta2_label }} →</a>
        {%- endif -%}
      </div>

      {%- if section.settings.countdown_enabled and section.settings.drop_date != blank -%}
        <div class="countdown" data-countdown="{{ section.settings.drop_date }}" aria-live="polite">
          <span class="countdown__label">{{ section.settings.countdown_label }}</span>
          <div class="countdown__clock">
            <span><b data-d>00</b>Days</span><i>:</i>
            <span><b data-h>00</b>Hrs</span><i>:</i>
            <span><b data-m>00</b>Min</span><i>:</i>
            <span><b data-s>00</b>Sec</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      <div class="hero__frame{% unless section.settings.image1 %} hero__frame--empty{% endunless %}">
        {%- if section.settings.image1 != blank -%}
          {{ section.settings.image1 | image_url: width: 1200 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width:1024px) 50vw, 100vw', widths: '600,900,1200,1600' }}
        {%- else -%}
          <span class="hero__wordmark">{{ shop.name }}</span>
        {%- endif -%}
        {%- if section.settings.collage_caption != blank -%}
          <span class="hero__chip">{{ section.settings.collage_caption }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Weekly Drops · Est. Boston" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You don't dress for the occasion." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent (italic)", "default": "You dress for the mood." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Minimal pieces that elevate your wardrobe instantly. New drop every Sunday." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA label", "default": "Shop the drop" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "Find your mood" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA link" },
    { "type": "header", "content": "Hero image" },
    { "type": "image_picker", "id": "image1", "label": "Image" },
    { "type": "text", "id": "collage_caption", "label": "Image caption", "default": "Drop 01" },
    { "type": "header", "content": "Drop countdown" },
    { "type": "checkbox", "id": "countdown_enabled", "label": "Show countdown", "default": true },
    { "type": "text", "id": "countdown_label", "label": "Countdown label", "default": "Next drop in" },
    { "type": "text", "id": "drop_date", "label": "Drop date (YYYY-MM-DD HH:MM)", "info": "e.g. 2026-06-07 13:00", "default": "2026-06-07 13:00" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
