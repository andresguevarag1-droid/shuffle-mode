{%- if section.blocks.size > 0 -%}
<div
  class="smann-bar"
  role="region"
  aria-label="Announcements"
  style="
    --smann-bar-bg: {{ section.settings.background_color }};
    --smann-bar-fg: {{ section.settings.text_color }};
    --smann-count: {{ section.blocks.size }};
    --smann-speed: {{ section.settings.speed }}s;
  "
>
  {%- if section.blocks.size == 1 -%}
    <div class="smann-bar__single">
      <span class="smann-bar__ember" aria-hidden="true">&#x2666;</span>
      <span class="smann-bar__msg">{{ section.blocks.first.settings.text }}</span>
      <span class="smann-bar__ember" aria-hidden="true">&#x2666;</span>
    </div>
  {%- else -%}
    <div class="smann-bar__rotate" aria-live="polite" aria-atomic="true">
      {%- for block in section.blocks -%}
        <span
          class="smann-bar__slide{% if forloop.first %} smann-bar__slide--active{% endif %}"
          data-index="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <span class="smann-bar__ember" aria-hidden="true">&#x2666;</span>
          {{ block.settings.text }}
          <span class="smann-bar__ember" aria-hidden="true">&#x2666;</span>
        </span>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>
{%- endif -%}

{% stylesheet %}
.smann-bar {
  --_bg: var(--smann-bar-bg, var(--color-ink));
  --_fg: var(--smann-bar-fg, var(--color-bone));
  background-color: var(--_bg);
  color: var(--_fg);
  width: 100%;
  overflow: hidden;
  position: relative;
  z-index: 200;
}

.smann-bar__single {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 0.6rem 1rem;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1;
}

.smann-bar__rotate {
  position: relative;
  height: 2.25rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.smann-bar__slide {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  padding: 0 1rem;
  font-family: var(--font-body);
  font-size: 0.6875rem;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  line-height: 1;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity 0.6s ease, transform 0.6s ease;
  pointer-events: none;
  white-space: nowrap;
}

.smann-bar__slide--active {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.smann-bar__slide--exit {
  opacity: 0;
  transform: translateY(-6px);
  pointer-events: none;
}

.smann-bar__ember {
  color: var(--color-ember);
  font-size: 0.45em;
  vertical-align: middle;
  display: inline-block;
  opacity: 0.9;
}

@media (prefers-reduced-motion: reduce) {
  .smann-bar__slide {
    transition: none;
  }
}

/* ── Small phone (≤480px) ── */
@media (max-width: 480px) {
  .smann-bar__single {
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.625rem;
    /* wrap long text rather than overflow the viewport */
    white-space: normal;
    text-align: center;
    line-height: 1.4;
    /* prevent horizontal overflow */
    max-width: 100%;
    overflow-wrap: break-word;
  }
  /* Rotate container: keep absolute-positioning layout intact for JS animation.
     Allow height to flex so wrapped text isn't clipped. */
  .smann-bar__rotate {
    height: auto;
    min-height: 2rem;
    padding-block: 0.4rem;
  }
  .smann-bar__slide {
    /* keep absolute so JS opacity/transform transitions still work */
    position: absolute;
    inset: 0;
    padding: 0.4rem 0.75rem;
    font-size: 0.625rem;
    gap: 0.5rem;
    white-space: normal;
    text-align: center;
    line-height: 1.4;
    /* prevent overflow, not horizontal scroll */
    overflow: hidden;
    max-width: 100%;
    overflow-wrap: break-word;
  }
}

/* ── Tiny phone (≤380px) ── */
@media (max-width: 380px) {
  .smann-bar__single {
    font-size: 0.5875rem;
    padding-inline: 0.5rem;
    letter-spacing: 0.08em;
  }
  .smann-bar__slide {
    font-size: 0.5875rem;
    padding-inline: 0.5rem;
    letter-spacing: 0.08em;
  }
  .smann-bar__ember {
    font-size: 0.38em;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  var bar = document.currentScript
    ? document.currentScript.closest('.smann-bar')
    : null;

  if (!bar) {
    var bars = document.querySelectorAll('.smann-bar');
    bar = bars[bars.length - 1];
  }

  if (!bar) return;

  var rotate = bar.querySelector('.smann-bar__rotate');
  if (!rotate) return;

  var slides = Array.prototype.slice.call(
    rotate.querySelectorAll('.smann-bar__slide')
  );
  if (slides.length < 2) return;

  var prefersReduced =
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (prefersReduced) {
    slides.forEach(function (s, i) {
      s.classList.remove('smann-bar__slide--active', 'smann-bar__slide--exit');
      if (i === 0) s.classList.add('smann-bar__slide--active');
    });
    return;
  }

  var speed = parseFloat(getComputedStyle(bar).getPropertyValue('--smann-speed')) || 4;
  var intervalMs = Math.max(speed * 1000, 2000);
  var current = 0;

  function advance() {
    var next = (current + 1) % slides.length;

    slides[current].classList.add('smann-bar__slide--exit');
    slides[current].classList.remove('smann-bar__slide--active');

    slides[next].classList.add('smann-bar__slide--active');
    slides[next].classList.remove('smann-bar__slide--exit');

    var leaving = slides[current];
    setTimeout(function () {
      leaving.classList.remove('smann-bar__slide--exit');
    }, 700);

    current = next;
    rotate.setAttribute('aria-label', slides[current].textContent.trim());
  }

  setInterval(advance, intervalMs);
})();
{% endjavascript %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#16130f"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#f6f2ea"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Rotation interval (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New drop every Sunday · 1PM ET"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping over $99" } },
        { "type": "message", "settings": { "text": "New drop every Sunday · 1PM ET" } },
        { "type": "message", "settings": { "text": "When it’s gone, it’s gone" } }
      ]
    }
  ]
}
{% endschema %}
