{%- liquid
  assign collection = collections[section.settings.collection]
  assign image_blocks = 0
  for block in section.blocks
    if block.settings.image != blank
      assign image_blocks = image_blocks | plus: 1
    endif
  endfor
-%}

{%- if image_blocks > 0 or collection != blank -%}
  <section id="lookbook" class="container section">
    <div class="section__head reveal">
      <div>
        <span class="eyebrow eyebrow--rule">{{ section.settings.eyebrow }}</span>
        <h2 class="section__title">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.link_url != blank -%}
        <a href="{{ section.settings.link_url }}" class="card__cat link-arrow">{{ section.settings.link_label }} →</a>
      {%- endif -%}
    </div>

    <div class="lookbook">
      {%- if image_blocks > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <figure class="lookbook__shot" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width:768px) 25vw, 50vw', widths: '400,700' }}
              {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for product in collection.products limit: 4 -%}
          <a href="{{ product.url }}" class="lookbook__shot">
            {%- if product.featured_image -%}
              <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.title | escape }}" loading="lazy">
            {%- endif -%}
            <figcaption>{{ product.title }}</figcaption>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lookbook" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Used when no shot images are added" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Morning, unbothered" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "shot", "settings": { "caption": "01 — Morning, unbothered" } },
        { "type": "shot", "settings": { "caption": "02 — The 6pm pivot" } },
        { "type": "shot", "settings": { "caption": "03 — Weekend, off the clock" } },
        { "type": "shot", "settings": { "caption": "04 — After hours" } }
      ]
    }
  ]
}
{% endschema %}
