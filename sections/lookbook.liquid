<section id="lookbook" class="container section">
  <div class="section__head reveal">
    <h2 class="section__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.link_url != blank -%}
      <a href="{{ section.settings.link_url }}" class="card__cat link-arrow">{{ section.settings.link_label }} →</a>
    {%- endif -%}
  </div>

  <div class="lookbook">
    {%- for block in section.blocks -%}
      <figure class="editorial-frame" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' }}
        {%- endif -%}
        <figcaption class="font-display" style="position:absolute;bottom:1rem;left:1rem;right:1rem;color:var(--color-cream);">{{ block.settings.caption }}</figcaption>
      </figure>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Lookbook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Lookbook" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "blocks": [
    {
      "type": "shot",
      "name": "Shot",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "Morning, unbothered" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook",
      "blocks": [
        { "type": "shot", "settings": { "caption": "01 — Morning, unbothered" } },
        { "type": "shot", "settings": { "caption": "02 — The 6pm pivot" } },
        { "type": "shot", "settings": { "caption": "03 — Weekend, off the clock" } },
        { "type": "shot", "settings": { "caption": "04 — After hours" } }
      ]
    }
  ]
}
{% endschema %}
