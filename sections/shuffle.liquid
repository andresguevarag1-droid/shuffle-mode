{%- assign collection = collections[section.settings.collection] -%}
<section id="shuffle" class="section section--sand">
  <div class="container shuffle__grid" data-shuffle>
    <div class="reveal">
      <span class="eyebrow eyebrow--rule">Shuffle Mode</span>
      <h2 class="section__title">{{ section.settings.heading }}</h2>
      <p class="hero__sub">{{ section.settings.subheading }}</p>

      <div class="chips">
        {%- for block in section.blocks -%}
          <button class="chip" type="button" data-mood="{{ forloop.index0 }}" {{ block.shopify_attributes }}
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>

      <button class="btn btn--ember shuffle__btn" type="button" data-shuffle-btn>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" data-shuffle-icon><path d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"/></svg>
        {{ section.settings.button_label }}
      </button>
    </div>

    <div class="shuffle__stage">
      {%- for block in section.blocks -%}
        <div class="look{% if forloop.first %} is-active{% endif %}" data-shuffle-panel="{{ forloop.index0 }}"
          style="background:linear-gradient(150deg, {{ block.settings.color1 }}, {{ block.settings.color2 }});">
          <p class="eyebrow look__eyebrow">Today you're feeling</p>
          <p class="look__label font-display">{{ block.settings.label }}</p>
          <p class="look__line font-display italic">“{{ block.settings.line }}”</p>

          <div class="look__pieces">
            {%- assign shown = 0 -%}
            {%- if collection != blank -%}
              {%- for product in collection.products -%}
                {%- if block.settings.tag != blank and product.tags contains block.settings.tag and shown < 2 -%}
                  <a href="{{ product.url }}" class="look__piece">
                    <span class="look__piece-img">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}</span>
                    <span class="look__piece-name">{{ product.title }}</span>
                    <span class="look__piece-price">{{ product.price | money }}</span>
                  </a>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if shown == 0 -%}
                {%- for product in collection.products limit: 2 -%}
                  <a href="{{ product.url }}" class="look__piece">
                    <span class="look__piece-img">{%- if product.featured_image -%}<img src="{{ product.featured_image | image_url: width: 240 }}" alt="{{ product.title | escape }}" loading="lazy">{%- endif -%}</span>
                    <span class="look__piece-name">{{ product.title }}</span>
                    <span class="look__piece-price">{{ product.price | money }}</span>
                  </a>
                  {%- assign shown = shown | plus: 1 -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endif -%}
            {%- if shown == 0 -%}
              <span class="look__piece"><span class="look__piece-img"></span><span class="look__piece-name">Connect a collection</span></span>
              <span class="look__piece"><span class="look__piece-img"></span><span class="look__piece-name">to see real looks</span></span>
            {%- endif -%}
          </div>

          {%- if section.settings.shop_url != blank -%}
            <a href="{{ section.settings.shop_url }}" class="btn look__shop">Shop this look →</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shuffle my mood",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what today is? Let it shuffle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick the mood you're in — or hit shuffle and let us read the room. We'll pull a look from this week's drop to match." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shuffle my mood" },
    { "type": "collection", "id": "collection", "label": "Source collection" },
    { "type": "url", "id": "shop_url", "label": "Shop link" }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Bold" },
        { "type": "text", "id": "line", "label": "Line", "default": "Walk in like you own the room — because today, you do." },
        { "type": "text", "id": "tag", "label": "Product tag to match", "info": "Products tagged with this show under the mood", "default": "bold" },
        { "type": "color", "id": "color1", "label": "Gradient start", "default": "#c2502e" },
        { "type": "color", "id": "color2", "label": "Gradient end", "default": "#7a2618" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shuffle my mood",
      "blocks": [
        { "type": "mood", "settings": { "label": "Bold", "line": "Walk in like you own the room — because today, you do.", "tag": "bold", "color1": "#c2502e", "color2": "#7a2618" } },
        { "type": "mood", "settings": { "label": "Soft", "line": "Unhurried, unbothered, undeniably put-together.", "tag": "soft", "color1": "#e3c9b5", "color2": "#b98c6d" } },
        { "type": "mood", "settings": { "label": "Sharp", "line": "Clean lines, clear head. Nothing left to prove.", "tag": "sharp", "color1": "#2c2a28", "color2": "#55504a" } },
        { "type": "mood", "settings": { "label": "Free", "line": "Loose, light, and going wherever the day takes you.", "tag": "free", "color1": "#9aa67f", "color2": "#5f6b48" } }
      ]
    }
  ]
}
{% endschema %}
