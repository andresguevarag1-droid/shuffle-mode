<section id="shuffle" class="section section--sand">
  <div class="container shuffle__grid" data-shuffle>
    <div class="reveal">
      <span class="eyebrow">Shuffle Mode</span>
      <h2 class="section__title" style="margin-top:1rem;">{{ section.settings.heading }}</h2>
      <p class="hero__sub" style="max-width:28rem;">{{ section.settings.subheading }}</p>

      <div class="chips">
        {%- for block in section.blocks -%}
          <button class="chip" type="button" data-mood {{ block.shopify_attributes }}
            {% if forloop.first %}aria-pressed="true"{% else %}aria-pressed="false"{% endif %}>
            {{ block.settings.label }}
          </button>
        {%- endfor -%}
      </div>

      <button class="btn btn--ember" type="button" data-shuffle-btn style="margin-top:2rem;">
        ✦ {{ section.settings.button_label }}
      </button>

      <script type="application/json" data-moods>
        [
          {%- for block in section.blocks -%}
            {
              "label": {{ block.settings.label | json }},
              "line": {{ block.settings.line | json }},
              "c0": {{ block.settings.color1 | json }},
              "c1": {{ block.settings.color2 | json }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
      </script>
    </div>

    {%- assign first = section.blocks.first -%}
    <div class="look-card" data-shuffle-card
      style="background:linear-gradient(145deg, {{ first.settings.color1 }}, {{ first.settings.color2 }});">
      <p class="eyebrow" style="color:rgba(251,249,244,0.7);">Today you're feeling</p>
      <p class="font-display" data-shuffle-label style="font-size:2.5rem;margin:0.5rem 0;">{{ first.settings.label }}</p>
      <p class="font-display italic" data-shuffle-line style="max-width:24rem;color:rgba(251,249,244,0.85);">“{{ first.settings.line }}”</p>
      <div class="look-card__pieces">
        <div class="look-piece"><div class="swatch"></div><p style="font-size:0.875rem;margin:0;">This week's pick</p></div>
        <div class="look-piece"><div class="swatch"></div><p style="font-size:0.875rem;margin:0;">Pairs with</p></div>
      </div>
      {%- if section.settings.shop_url != blank -%}
        <a href="{{ section.settings.shop_url }}" class="btn" style="margin-top:1.75rem;background:var(--color-cream);color:var(--color-ink);">Shop this look →</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shuffle my mood",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Not sure what today is? Let it shuffle." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Pick the mood you're in — or hit shuffle and let us read the room." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shuffle my mood" },
    { "type": "url", "id": "shop_url", "label": "Shop link" }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Bold" },
        { "type": "text", "id": "line", "label": "Line", "default": "Walk in like you own the room — because today, you do." },
        { "type": "color", "id": "color1", "label": "Gradient start", "default": "#c2502e" },
        { "type": "color", "id": "color2", "label": "Gradient end", "default": "#7a2618" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shuffle my mood",
      "blocks": [
        { "type": "mood", "settings": { "label": "Bold", "line": "Walk in like you own the room — because today, you do.", "color1": "#c2502e", "color2": "#7a2618" } },
        { "type": "mood", "settings": { "label": "Soft", "line": "Unhurried, unbothered, undeniably put-together.", "color1": "#e3c9b5", "color2": "#b98c6d" } },
        { "type": "mood", "settings": { "label": "Sharp", "line": "Clean lines, clear head. Nothing left to prove.", "color1": "#2c2a28", "color2": "#55504a" } },
        { "type": "mood", "settings": { "label": "Free", "line": "Loose, light, and going wherever the day takes you.", "color1": "#9aa67f", "color2": "#5f6b48" } }
      ]
    }
  ]
}
{% endschema %}
