{%- assign smsh_collection = collections[section.settings.collection] -%}
{%- assign smsh_block_count = section.blocks | size -%}

<span id="shuffle" class="smsh-anchor" aria-hidden="true"></span>
<section
  id="smsh-root-{{ section.id }}"
  class="smsh-root"
  aria-label="Shuffle your mood"
  style="
    --smsh-c1: {{ section.blocks[0].settings.color1 }};
    --smsh-c2: {{ section.blocks[0].settings.color2 }};
    --smsh-panels: {{ smsh_block_count }};
  "
>
  {%- comment -%} ── ambient bg that morphs with the active mood ── {%- endcomment -%}
  <div class="smsh-ambient" aria-hidden="true"></div>

  <div class="container smsh-layout">

    {%- comment -%} ── LEFT: editorial headline + mood pills + CTA ── {%- endcomment -%}
    <div class="smsh-copy">

      <p class="smsh-eyebrow" aria-hidden="true">
        <span class="smsh-eyebrow__dash"></span>Shuffle Mode
      </p>

      <h2 class="smsh-heading">
        {%- assign smsh_words = section.settings.heading | split: ' ' -%}
        {%- for smsh_word in smsh_words -%}
          <span class="smsh-heading__word">{{ smsh_word }}</span>{% unless forloop.last %} {% endunless %}
        {%- endfor -%}
      </h2>

      <p class="smsh-sub">{{ section.settings.subheading }}</p>

      {%- comment -%} mood pills {%- endcomment -%}
      <div class="smsh-pills" role="group" aria-label="Choose your mood">
        {%- for block in section.blocks -%}
          <button
            class="smsh-pill{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-smsh-mood="{{ forloop.index0 }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            style="--smsh-pill-c1: {{ block.settings.color1 }}; --smsh-pill-c2: {{ block.settings.color2 }};"
            {{ block.shopify_attributes }}
          >
            <span class="smsh-pill__inner">{{ block.settings.label }}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- comment -%} shuffle CTA {%- endcomment -%}
      <button class="smsh-shuffle-btn" type="button" data-smsh-shuffle aria-label="{{ section.settings.button_label }}">
        <span class="smsh-shuffle-btn__track" aria-hidden="true">
          <svg class="smsh-shuffle-btn__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 3h5v5"/><path d="M4 20 21 3"/><path d="M21 16v5h-5"/><path d="M15 15l6 6"/><path d="M4 4l5 5"/>
          </svg>
        </span>
        <span class="smsh-shuffle-btn__label">{{ section.settings.button_label }}</span>
      </button>

    </div>

    {%- comment -%} ── RIGHT: mood stage ── {%- endcomment -%}
    <div class="smsh-stage" aria-live="polite" aria-atomic="true">

      {%- comment -%} decorative frame lines {%- endcomment -%}
      <div class="smsh-frame" aria-hidden="true">
        <span class="smsh-frame__tl"></span>
        <span class="smsh-frame__tr"></span>
        <span class="smsh-frame__bl"></span>
        <span class="smsh-frame__br"></span>
      </div>

      {%- for block in section.blocks -%}
        {%- assign smsh_idx = forloop.index0 -%}
        <div
          class="smsh-panel{% if forloop.first %} is-active{% endif %}"
          data-smsh-panel="{{ smsh_idx }}"
          style="
            --smsh-panel-c1: {{ block.settings.color1 }};
            --smsh-panel-c2: {{ block.settings.color2 }};
          "
          role="region"
          aria-label="Mood: {{ block.settings.label }}"
          aria-hidden="{% unless forloop.first %}true{% endunless %}"
          {{ block.shopify_attributes }}
        >

          <div class="smsh-panel__inner">

            {%- comment -%} mood identity {%- endcomment -%}
            <div class="smsh-mood-id">
              <p class="smsh-mood-id__pre">Today you are feeling</p>
              <p class="smsh-mood-id__name">{{ block.settings.label }}</p>
              <p class="smsh-mood-id__line">&ldquo;{{ block.settings.line }}&rdquo;</p>
            </div>

            {%- comment -%} product tiles {%- endcomment -%}
            <div class="smsh-look">
              {%- assign smsh_shown = 0 -%}
              {%- if smsh_collection != blank -%}
                {%- if block.settings.tag != blank -%}
                  {%- for product in smsh_collection.products -%}
                    {%- if product.tags contains block.settings.tag and smsh_shown < 2 -%}
                      <a href="{{ product.url }}" class="smsh-tile" tabindex="{% unless forloop.first == false or smsh_idx == 0 %}-1{% endunless %}">
                        <span class="smsh-tile__img-wrap">
                          {%- if product.featured_image -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 400 }}"
                              alt="{{ product.title | escape }}"
                              width="200" height="260"
                              loading="lazy"
                              class="smsh-tile__img"
                            >
                          {%- else -%}
                            <span class="smsh-tile__img smsh-tile__img--empty" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="smsh-tile__overlay" aria-hidden="true"></span>
                        </span>
                        <span class="smsh-tile__meta">
                          <span class="smsh-tile__name">{{ product.title }}</span>
                          <span class="smsh-tile__price">{{ product.price | money }}</span>
                        </span>
                        <span class="smsh-tile__cta" aria-hidden="true">View →</span>
                      </a>
                      {%- assign smsh_shown = smsh_shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                {%- if smsh_shown < 2 -%}
                  {%- for product in smsh_collection.products limit: 2 offset: smsh_shown -%}
                    {%- if smsh_shown < 2 -%}
                      <a href="{{ product.url }}" class="smsh-tile">
                        <span class="smsh-tile__img-wrap">
                          {%- if product.featured_image -%}
                            <img
                              src="{{ product.featured_image | image_url: width: 400 }}"
                              alt="{{ product.title | escape }}"
                              width="200" height="260"
                              loading="lazy"
                              class="smsh-tile__img"
                            >
                          {%- else -%}
                            <span class="smsh-tile__img smsh-tile__img--empty" aria-hidden="true"></span>
                          {%- endif -%}
                          <span class="smsh-tile__overlay" aria-hidden="true"></span>
                        </span>
                        <span class="smsh-tile__meta">
                          <span class="smsh-tile__name">{{ product.title }}</span>
                          <span class="smsh-tile__price">{{ product.price | money }}</span>
                        </span>
                        <span class="smsh-tile__cta" aria-hidden="true">View →</span>
                      </a>
                      {%- assign smsh_shown = smsh_shown | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              {%- endif -%}
              {%- if smsh_shown == 0 -%}
                <span class="smsh-tile smsh-tile--placeholder">
                  <span class="smsh-tile__img-wrap"><span class="smsh-tile__img smsh-tile__img--empty" aria-hidden="true"></span></span>
                  <span class="smsh-tile__meta"><span class="smsh-tile__name">Connect a collection</span><span class="smsh-tile__price">to see the look</span></span>
                </span>
                <span class="smsh-tile smsh-tile--placeholder">
                  <span class="smsh-tile__img-wrap"><span class="smsh-tile__img smsh-tile__img--empty" aria-hidden="true"></span></span>
                  <span class="smsh-tile__meta"><span class="smsh-tile__name">in the editor</span><span class="smsh-tile__price">&nbsp;</span></span>
                </span>
              {%- endif -%}
            </div>

            {%- comment -%} shop CTA {%- endcomment -%}
            {%- if section.settings.shop_url != blank -%}
              <a href="{{ section.settings.shop_url }}" class="smsh-shop-cta">
                <span>Shop this look</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {%- endif -%}

          </div>{%- comment -%}/.smsh-panel__inner{%- endcomment -%}
        </div>{%- comment -%}/.smsh-panel{%- endcomment -%}
      {%- endfor -%}

    </div>{%- comment -%}/.smsh-stage{%- endcomment -%}
  </div>{%- comment -%}/.smsh-layout{%- endcomment -%}
</section>

{% stylesheet %}
.smsh-anchor { display: block; height: 0; scroll-margin-top: 6rem; }
/* ═══════════════════════════════════════════════════
   SHUFFLE MODE — smsh-* namespace
   All CSS custom properties prefixed --smsh-
═══════════════════════════════════════════════════ */

/* ── tokens ── */
.smsh-root {
  --smsh-bone:   var(--color-bone);
  --smsh-ink:    var(--color-ink);
  --smsh-cream:  var(--color-cream);
  --smsh-sand:   var(--color-sand);
  --smsh-ember:  var(--color-ember);
  --smsh-stone:  var(--color-stone);
  --smsh-line:   var(--color-line);
  --smsh-radius: 2px;
  --smsh-pill-r: 999px;
  --smsh-ease:   cubic-bezier(.22,.6,.36,1);
  --smsh-ease-spring: cubic-bezier(.34,1.56,.64,1);
  --smsh-dur:    .72s;
  --smsh-dur-fast: .28s;
  --smsh-c1: var(--color-ember);
  --smsh-c2: #7a2618;

  position: relative;
  overflow: hidden;
  background: var(--color-cream, var(--smsh-cream));
  color: var(--color-ink, var(--smsh-ink));
  padding: clamp(4rem, 8vw, 7rem) 0;
  isolation: isolate;
}

/* ── ambient morphing bg ── */
.smsh-ambient {
  position: absolute;
  inset: -20%;
  border-radius: 50%;
  background: radial-gradient(ellipse at 60% 40%, var(--smsh-c1), var(--smsh-c2) 80%);
  opacity: .07;
  filter: blur(80px);
  transition: background var(--smsh-dur) var(--smsh-ease), opacity var(--smsh-dur) var(--smsh-ease);
  will-change: background, opacity;
  pointer-events: none;
  z-index: 0;
}

/* ── layout ── */
.smsh-layout {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(40px, 6vw, 96px);
  align-items: center;
}

@media (max-width: 860px) {
  .smsh-layout {
    grid-template-columns: 1fr;
    gap: 56px;
  }
}

/* ── eyebrow ── */
.smsh-eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: var(--font-body, Inter, sans-serif);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--smsh-stone);
  margin: 0 0 24px;
}

.smsh-eyebrow__dash {
  display: block;
  width: 32px;
  height: 1px;
  background: currentColor;
  opacity: .5;
  flex-shrink: 0;
}

/* ── heading — staggered word reveal ── */
.smsh-heading {
  font-family: var(--font-display, Fraunces, serif);
  font-size: clamp(2.4rem, 4.8vw, 4.2rem);
  font-weight: 300;
  line-height: 1.08;
  letter-spacing: -.02em;
  color: var(--smsh-ink);
  margin: 0 0 20px;
  overflow: hidden;
}

.smsh-heading__word {
  display: inline-block;
  opacity: 0;
  transform: translateY(40px) rotate(2deg);
  animation: smsh-word-in var(--smsh-dur) var(--smsh-ease) forwards;
}

.smsh-heading__word:nth-child(1)  { animation-delay: .05s; }
.smsh-heading__word:nth-child(2)  { animation-delay: .12s; }
.smsh-heading__word:nth-child(3)  { animation-delay: .19s; }
.smsh-heading__word:nth-child(4)  { animation-delay: .26s; }
.smsh-heading__word:nth-child(5)  { animation-delay: .33s; }
.smsh-heading__word:nth-child(6)  { animation-delay: .40s; }
.smsh-heading__word:nth-child(7)  { animation-delay: .47s; }
.smsh-heading__word:nth-child(8)  { animation-delay: .54s; }
.smsh-heading__word:nth-child(9)  { animation-delay: .61s; }
.smsh-heading__word:nth-child(10) { animation-delay: .68s; }

@keyframes smsh-word-in {
  to { opacity: 1; transform: none; }
}

/* ── subheading ── */
.smsh-sub {
  font-family: var(--font-body, Inter, sans-serif);
  font-size: clamp(.875rem, 1.4vw, 1.0625rem);
  line-height: 1.7;
  color: var(--smsh-stone);
  margin: 0 0 40px;
  max-width: 38ch;
}

/* ── mood pills ── */
.smsh-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-bottom: 36px;
}

.smsh-pill {
  appearance: none;
  border: 1px solid var(--smsh-line);
  border-radius: var(--smsh-pill-r);
  background: transparent;
  padding: 10px 22px;
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .8125rem;
  font-weight: 500;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--smsh-stone);
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition:
    color         var(--smsh-dur-fast) var(--smsh-ease),
    border-color  var(--smsh-dur-fast) var(--smsh-ease),
    transform     var(--smsh-dur-fast) var(--smsh-ease-spring);
  -webkit-tap-highlight-color: transparent;
}

.smsh-pill::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--smsh-pill-c1), var(--smsh-pill-c2));
  opacity: 0;
  transition: opacity var(--smsh-dur-fast) var(--smsh-ease);
  border-radius: inherit;
}

.smsh-pill .smsh-pill__inner {
  position: relative;
  z-index: 1;
}

.smsh-pill:hover,
.smsh-pill:focus-visible {
  border-color: transparent;
  color: var(--smsh-bone);
  transform: translateY(-2px) scale(1.03);
  outline: none;
}

.smsh-pill:hover::before,
.smsh-pill:focus-visible::before {
  opacity: 1;
}

.smsh-pill.is-active {
  border-color: transparent;
  color: var(--smsh-bone);
  transform: none;
}

.smsh-pill.is-active::before {
  opacity: 1;
}

.smsh-pill:focus-visible {
  box-shadow: 0 0 0 3px var(--smsh-ember);
}

/* ── shuffle button ── */
.smsh-shuffle-btn {
  appearance: none;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: var(--smsh-ink);
  color: var(--smsh-bone);
  border: none;
  border-radius: var(--smsh-radius);
  padding: 16px 32px;
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .875rem;
  font-weight: 500;
  letter-spacing: .06em;
  text-transform: uppercase;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: transform var(--smsh-dur-fast) var(--smsh-ease-spring),
              box-shadow var(--smsh-dur-fast) var(--smsh-ease);
  -webkit-tap-highlight-color: transparent;
}

.smsh-shuffle-btn::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--smsh-c1), var(--smsh-c2));
  opacity: 0;
  transition: opacity var(--smsh-dur) var(--smsh-ease);
}

.smsh-shuffle-btn:hover::after,
.smsh-shuffle-btn:focus-visible::after {
  opacity: 1;
}

.smsh-shuffle-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 40px rgba(22,19,15,.18);
}

.smsh-shuffle-btn:active {
  transform: translateY(0) scale(.98);
}

.smsh-shuffle-btn:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px var(--smsh-ember);
}

.smsh-shuffle-btn__track {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.smsh-shuffle-btn__icon {
  width: 18px;
  height: 18px;
  transition: transform var(--smsh-dur-fast) var(--smsh-ease-spring);
}

.smsh-shuffle-btn:hover .smsh-shuffle-btn__icon {
  transform: rotate(180deg) scale(1.1);
}

.smsh-shuffle-btn__label {
  position: relative;
  z-index: 1;
}

/* ── stage ── */
.smsh-stage {
  position: relative;
  min-height: 480px;
}

/* ── decorative frame ── */
.smsh-frame {
  position: absolute;
  inset: -10px;
  pointer-events: none;
  z-index: 2;
}

.smsh-frame span {
  position: absolute;
  background: var(--smsh-ink);
  opacity: .12;
  transition: opacity var(--smsh-dur) var(--smsh-ease);
}

.smsh-frame__tl,
.smsh-frame__tr,
.smsh-frame__bl,
.smsh-frame__br {
  width: 24px;
  height: 24px;
}

.smsh-frame__tl { top: 10px;    left: 10px;   border-top: 1px solid; border-left: 1px solid; background: none; opacity: .25; width: 20px; height: 20px; }
.smsh-frame__tr { top: 10px;    right: 10px;  border-top: 1px solid; border-right: 1px solid; background: none; opacity: .25; width: 20px; height: 20px; }
.smsh-frame__bl { bottom: 10px; left: 10px;   border-bottom: 1px solid; border-left: 1px solid; background: none; opacity: .25; width: 20px; height: 20px; }
.smsh-frame__br { bottom: 10px; right: 10px;  border-bottom: 1px solid; border-right: 1px solid; background: none; opacity: .25; width: 20px; height: 20px; }

/* ── panels ── */
.smsh-panel {
  position: absolute;
  inset: 0;
  border-radius: 4px;
  overflow: hidden;
  opacity: 0;
  transform: translateY(24px) scale(.97);
  pointer-events: none;
  transition:
    opacity     var(--smsh-dur) var(--smsh-ease),
    transform   var(--smsh-dur) var(--smsh-ease);
  will-change: opacity, transform;
}

.smsh-panel.is-active {
  opacity: 1;
  transform: none;
  pointer-events: auto;
}

.smsh-panel.is-exit {
  opacity: 0;
  transform: translateY(-20px) scale(.98);
  pointer-events: none;
}

.smsh-panel__inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: clamp(28px, 4vw, 44px);
  background: linear-gradient(150deg, var(--smsh-panel-c1), var(--smsh-panel-c2));
  min-height: 480px;
}

/* ── mood identity text ── */
.smsh-mood-id {
  margin-bottom: 28px;
}

.smsh-mood-id__pre {
  font-family: var(--font-body, Inter, sans-serif);
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.65);
  margin: 0 0 6px;
}

.smsh-mood-id__name {
  font-family: var(--font-display, Fraunces, serif);
  font-size: clamp(2.4rem, 5vw, 3.8rem);
  font-weight: 300;
  line-height: 1;
  letter-spacing: -.03em;
  color: #fff;
  margin: 0 0 14px;
}

.smsh-mood-id__line {
  font-family: var(--font-display, Fraunces, serif);
  font-size: clamp(1rem, 1.6vw, 1.1875rem);
  font-style: italic;
  font-weight: 300;
  line-height: 1.5;
  color: rgba(255,255,255,.82);
  margin: 0;
}

/* ── product look tiles ── */
.smsh-look {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  flex: 1;
  margin-bottom: 24px;
}

.smsh-tile {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  border-radius: 3px;
  overflow: hidden;
  background: rgba(255,255,255,.12);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.18);
  transition:
    transform     var(--smsh-dur-fast) var(--smsh-ease-spring),
    box-shadow    var(--smsh-dur-fast) var(--smsh-ease),
    background    var(--smsh-dur-fast) var(--smsh-ease);
  position: relative;
  group: tile;
}

.smsh-tile:hover,
.smsh-tile:focus-visible {
  transform: translateY(-5px) scale(1.02);
  box-shadow: 0 20px 48px rgba(0,0,0,.25);
  background: rgba(255,255,255,.2);
  outline: none;
}

.smsh-tile:focus-visible {
  box-shadow: 0 0 0 3px rgba(255,255,255,.8), 0 20px 48px rgba(0,0,0,.2);
}

.smsh-tile__img-wrap {
  position: relative;
  aspect-ratio: 3/4;
  overflow: hidden;
  background: rgba(255,255,255,.08);
}

.smsh-tile__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .6s var(--smsh-ease);
}

.smsh-tile:hover .smsh-tile__img {
  transform: scale(1.06);
}

.smsh-tile__img--empty {
  width: 100%;
  height: 100%;
  display: block;
  background: rgba(255,255,255,.1);
}

.smsh-tile__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.4) 0%, transparent 50%);
  opacity: 0;
  transition: opacity var(--smsh-dur-fast) var(--smsh-ease);
}

.smsh-tile:hover .smsh-tile__overlay {
  opacity: 1;
}

.smsh-tile__meta {
  padding: 12px 14px 10px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.smsh-tile__name {
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .75rem;
  font-weight: 500;
  line-height: 1.4;
  color: rgba(255,255,255,.95);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.smsh-tile__price {
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .6875rem;
  font-weight: 400;
  letter-spacing: .03em;
  color: rgba(255,255,255,.65);
}

.smsh-tile__cta {
  position: absolute;
  bottom: 10px;
  right: 12px;
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .6875rem;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #fff;
  opacity: 0;
  transform: translateX(-4px);
  transition:
    opacity   var(--smsh-dur-fast) var(--smsh-ease),
    transform var(--smsh-dur-fast) var(--smsh-ease);
}

.smsh-tile:hover .smsh-tile__cta {
  opacity: 1;
  transform: none;
}

/* ── shop CTA ── */
.smsh-shop-cta {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  align-self: flex-start;
  font-family: var(--font-body, Inter, sans-serif);
  font-size: .8125rem;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(255,255,255,.9);
  text-decoration: none;
  padding-bottom: 3px;
  border-bottom: 1px solid rgba(255,255,255,.35);
  transition:
    color         var(--smsh-dur-fast) var(--smsh-ease),
    border-color  var(--smsh-dur-fast) var(--smsh-ease),
    gap           var(--smsh-dur-fast) var(--smsh-ease-spring);
}

.smsh-shop-cta:hover,
.smsh-shop-cta:focus-visible {
  color: #fff;
  border-color: rgba(255,255,255,.8);
  gap: 14px;
  outline: none;
}

.smsh-shop-cta:focus-visible {
  box-shadow: 0 0 0 3px rgba(255,255,255,.8);
  border-radius: 2px;
}

/* ── spinning animation during shuffle ── */
@keyframes smsh-spin {
  0%   { transform: rotate(0deg) scale(1); }
  30%  { transform: rotate(135deg) scale(1.18); }
  70%  { transform: rotate(315deg) scale(1.08); }
  100% { transform: rotate(360deg) scale(1); }
}

@keyframes smsh-panel-flash {
  0%   { opacity: 1; transform: none; }
  20%  { opacity: .4; transform: translateY(8px) scale(.98); }
  50%  { opacity: .6; transform: translateY(-6px) scale(1.01); }
  80%  { opacity: .8; transform: translateY(4px); }
  100% { opacity: 1; transform: none; }
}

.smsh-shuffle-btn.is-spinning .smsh-shuffle-btn__icon {
  animation: smsh-spin .72s var(--smsh-ease) forwards;
}

/* ── ticker: mood name cycling during shuffle ── */
.smsh-mood-id__name.is-cycling {
  animation: smsh-panel-flash .18s var(--smsh-ease) forwards;
}

/* ── reduced motion ── */
@media (prefers-reduced-motion: reduce) {
  .smsh-heading__word {
    opacity: 1;
    transform: none;
    animation: none;
  }

  .smsh-panel {
    transition: opacity .2s linear;
    transform: none !important;
  }

  .smsh-panel.is-exit {
    transform: none !important;
  }

  .smsh-shuffle-btn,
  .smsh-pill,
  .smsh-tile,
  .smsh-shop-cta,
  .smsh-shuffle-btn__icon,
  .smsh-tile__img,
  .smsh-tile__overlay,
  .smsh-tile__cta,
  .smsh-ambient {
    transition: none !important;
    animation: none !important;
  }

  .smsh-shuffle-btn.is-spinning .smsh-shuffle-btn__icon {
    animation: none !important;
  }

  .smsh-panel.is-active,
  .smsh-pill.is-active,
  .smsh-tile:hover {
    transform: none !important;
  }
}

/* ── mobile ── */
@media (max-width: 580px) {
  .smsh-panel__inner {
    min-height: 520px;
  }

  .smsh-look {
    gap: 10px;
  }

  .smsh-mood-id__name {
    font-size: 2.4rem;
  }

  .smsh-shuffle-btn {
    width: 100%;
    justify-content: center;
  }

  .smsh-pills {
    gap: 8px;
  }
}
{% endstylesheet %}

{% javascript %}
(function () {
  'use strict';

  /* ── read prefers-reduced-motion once ── */
  var smshReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── gather data from DOM ── */
  function smshInit(root) {
    if (!root) return;

    var pills     = Array.from(root.querySelectorAll('[data-smsh-mood]'));
    var panels    = Array.from(root.querySelectorAll('[data-smsh-panel]'));
    var shuffleBtn = root.querySelector('[data-smsh-shuffle]');
    var ambient   = root.querySelector('.smsh-ambient');
    var icon      = shuffleBtn ? shuffleBtn.querySelector('.smsh-shuffle-btn__icon') : null;

    if (!pills.length || !panels.length) return;

    var current = 0;
    var isAnimating = false;
    var tickerTimer = null;

    /* ── core: activate a mood by index ── */
    function activate(idx, animate) {
      if (idx === current && !animate) return;

      var prev    = current;
      current     = idx;

      /* panels */
      var prevPanel = panels[prev];
      var nextPanel = panels[idx];

      if (prevPanel && prevPanel !== nextPanel) {
        prevPanel.classList.add('is-exit');
        prevPanel.classList.remove('is-active');
        prevPanel.setAttribute('aria-hidden', 'true');
        var exitDur = smshReducedMotion ? 200 : 720;
        setTimeout(function () {
          if (prevPanel) prevPanel.classList.remove('is-exit');
        }, exitDur);
      }

      if (nextPanel) {
        nextPanel.classList.add('is-active');
        nextPanel.removeAttribute('aria-hidden');
      }

      /* pills */
      pills.forEach(function (p, i) {
        var active = i === idx;
        p.classList.toggle('is-active', active);
        p.setAttribute('aria-pressed', String(active));
      });

      /* ambient bg morph */
      var c1 = getComputedStyle(nextPanel).getPropertyValue('--smsh-panel-c1').trim();
      var c2 = getComputedStyle(nextPanel).getPropertyValue('--smsh-panel-c2').trim();
      root.style.setProperty('--smsh-c1', c1);
      root.style.setProperty('--smsh-c2', c2);

      if (ambient) {
        ambient.style.background = 'radial-gradient(ellipse at 60% 40%, ' + c1 + ', ' + c2 + ' 80%)';
      }
    }

    /* ── pill clicks ── */
    pills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        var idx = parseInt(pill.getAttribute('data-smsh-mood'), 10);
        activate(idx, false);
      });
    });

    /* ── shuffle: rapid-fire ticker, land on random ── */
    function shuffle() {
      if (isAnimating) return;
      isAnimating = true;

      /* spin the button icon */
      if (shuffleBtn) {
        shuffleBtn.classList.add('is-spinning');
        if (!smshReducedMotion) {
          setTimeout(function () {
            shuffleBtn.classList.remove('is-spinning');
          }, 720);
        } else {
          shuffleBtn.classList.remove('is-spinning');
        }
      }

      if (smshReducedMotion) {
        /* reduced: just jump to random immediately */
        var target = randomOtherIndex(current, panels.length);
        activate(target, false);
        isAnimating = false;
        return;
      }

      /* full animation: cycle through moods rapidly */
      var totalDur  = 1600;  /* ms total shuffle duration */
      var startTime = performance.now();
      var cycleIdx  = current;
      var count     = 0;

      /* variable interval: fast → slow easing */
      function tick(now) {
        var elapsed  = now - startTime;
        var progress = Math.min(elapsed / totalDur, 1);
        /* ease-out: interval grows from 80ms → 300ms */
        var interval = 80 + progress * 220;

        /* advance to next mood (skip current to feel more random) */
        cycleIdx = (cycleIdx + 1) % panels.length;
        count++;

        /* flash just the label text for cheap ticker effect */
        var nameEl = panels[cycleIdx] ? panels[cycleIdx].querySelector('.smsh-mood-id__name') : null;
        /* update ambient+pills on each tick for colour cascade */
        activate(cycleIdx, false);

        if (nameEl && !smshReducedMotion) {
          nameEl.classList.remove('is-cycling');
          void nameEl.offsetWidth; /* reflow trigger */
          nameEl.classList.add('is-cycling');
          setTimeout(function () { if (nameEl) nameEl.classList.remove('is-cycling'); }, 180);
        }

        if (progress < 1) {
          tickerTimer = setTimeout(function () {
            tick(performance.now());
          }, interval);
        } else {
          /* done — ensure we land on a different mood than we started */
          if (cycleIdx === parseInt(pills[current] ? pills[current].getAttribute('data-smsh-mood') : '0', 10) && panels.length > 1) {
            cycleIdx = (cycleIdx + 1) % panels.length;
            activate(cycleIdx, false);
          }
          isAnimating = false;
          /* tactile pulse on button */
          if (shuffleBtn) {
            shuffleBtn.style.transform = 'scale(1.04)';
            setTimeout(function () {
              shuffleBtn.style.transform = '';
            }, 160);
          }
        }
      }

      tickerTimer = setTimeout(function () { tick(performance.now()); }, 0);
    }

    function randomOtherIndex(cur, len) {
      if (len <= 1) return 0;
      var r;
      do { r = Math.floor(Math.random() * len); } while (r === cur);
      return r;
    }

    if (shuffleBtn) {
      shuffleBtn.addEventListener('click', shuffle);
    }

    /* ── keyboard: arrow navigation on pills ── */
    pills.forEach(function (pill, i) {
      pill.addEventListener('keydown', function (e) {
        var dir = 0;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') dir = 1;
        if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   dir = -1;
        if (!dir) return;
        e.preventDefault();
        var next = (i + dir + pills.length) % pills.length;
        pills[next].focus();
        activate(next, false);
      });
    });

    /* ── intersection observer: stagger heading words on entry ── */
    if ('IntersectionObserver' in window && !smshReducedMotion) {
      var words = Array.from(root.querySelectorAll('.smsh-heading__word'));
      if (words.length) {
        words.forEach(function (w) {
          w.style.opacity = '0';
          w.style.transform = 'translateY(40px) rotate(2deg)';
          w.style.animation = 'none';
        });

        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            io.unobserve(entry.target);
            words.forEach(function (w, wi) {
              setTimeout(function () {
                w.style.transition = 'opacity .7s cubic-bezier(.22,.6,.36,1), transform .7s cubic-bezier(.22,.6,.36,1)';
                w.style.opacity    = '1';
                w.style.transform  = 'none';
              }, wi * 70);
            });
          });
        }, { threshold: 0.3 });

        io.observe(root);
      }
    }
  }

  /* ── initialise all instances on page ── */
  function smshBoot() {
    document.querySelectorAll('.smsh-root').forEach(smshInit);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', smshBoot);
  } else {
    smshBoot();
  }

  /* ── Shopify section re-render (theme editor) ── */
  if (window.Shopify && window.Shopify.designMode) {
    document.addEventListener('shopify:section:load', function (e) {
      var sec = e.target;
      if (sec) smshInit(sec.querySelector('.smsh-root'));
    });
    document.addEventListener('shopify:block:select', function (e) {
      var root = e.target.closest('.smsh-root');
      if (!root) return;
      var idx = e.target ? e.target.getAttribute('data-smsh-panel') : null;
      if (idx !== null) {
        var pills = Array.from(root.querySelectorAll('[data-smsh-mood]'));
        if (pills[parseInt(idx, 10)]) pills[parseInt(idx, 10)].click();
      }
    });
  }
}());
{% endjavascript %}

