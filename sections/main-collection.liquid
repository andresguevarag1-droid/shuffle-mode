<section class="container section">
  <header class="reveal" style="max-width:40rem;">
    <span class="eyebrow">{{ collection.title }}</span>
    <h1 class="section__title" style="margin-top:1rem;">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="rte" style="margin-top:1.25rem;color:var(--color-stone);">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.products_per_page -%}
    <div class="product-grid" style="margin-top:3rem;">
      {%- for product in collection.products -%}
        {% render 'product-card', product: product %}
      {%- else -%}
        <p>No products in this collection yet.</p>
      {%- endfor -%}
    </div>

    {%- if paginate.pages > 1 -%}
      <div class="center mt-12">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "products_per_page", "min": 6, "max": 24, "step": 6, "label": "Products per page", "default": 12 }
  ]
}
{% endschema %}
