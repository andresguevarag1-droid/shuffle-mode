<section class="container section">
  <header class="reveal" style="max-width:40rem;">
    <span class="eyebrow">The Journal</span>
    <h1 class="section__title" style="margin-top:1rem;">{{ blog.title }}</h1>
  </header>

  {%- paginate blog.articles by 12 -%}
    <div class="product-grid" style="margin-top:3rem;">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="card">
          <div class="card__media editorial-frame">
            {%- if article.image -%}
              <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.image.alt | escape | default: article.title }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
            {%- endif -%}
          </div>
          <div style="margin-top:1rem;">
            <span class="eyebrow">{{ article.published_at | date: '%B %-d, %Y' }}</span>
            <h2 class="font-display" style="font-size:1.5rem;margin-top:0.5rem;">{{ article.title }}</h2>
            {%- if article.excerpt != blank -%}<p class="card__cat" style="margin-top:0.5rem;">{{ article.excerpt | strip_html | truncate: 120 }}</p>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}<div class="center mt-12">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
