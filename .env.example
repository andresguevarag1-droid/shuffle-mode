# Shopify Storefront API (headless)
#
# Leave these unset to run on the built-in mock catalog (src/lib/content.ts).
# Set all three to pull the live catalog from your Shopify store.
#
# 1. Shopify admin → Settings → Apps and sales channels → Develop apps
# 2. Create an app, enable the Storefront API, and grant at least:
#    unauthenticated_read_product_listings, unauthenticated_read_product_inventory
# 3. Install the app and copy the Storefront API access token below.

# e.g. your-store.myshopify.com  (no https://, no trailing slash)
SHOPIFY_STORE_DOMAIN=

# Storefront API access token (public)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Optional — defaults to 2024-10
SHOPIFY_STOREFRONT_API_VERSION=2024-10

# Secret guarding POST /api/revalidate (Shopify products webhook → cache refresh).
# If set, the webhook must send ?secret=… or an x-revalidation-secret header.
SHOPIFY_REVALIDATION_SECRET=

# Public site URL used for sitemap.xml / robots.txt / canonical links.
NEXT_PUBLIC_SITE_URL=https://shufflemode.us

# Optional — forward newsletter signups to your provider (Klaviyo/Mailchimp/…).
# If unset, /api/subscribe just validates and accepts (dev mode).
NEWSLETTER_WEBHOOK_URL=
