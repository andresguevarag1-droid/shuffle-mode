[  {
    "name": "theme_info",
    "theme_name": "Shuffle Mode",
    "theme_version": "1.0.0",
    "theme_author": "Shuffle Mode",
    "theme_documentation_url": "https://shufflemode.us",
    "theme_support_url": "https://shufflemode.us"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bone",
        "label": "Page background (bone)",
        "default": "#f6f2ea"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (text / dark sections)",
        "default": "#16130f"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Cream (on-dark text)",
        "default": "#fbf9f4"
      },
      {
        "type": "color",
        "id": "color_sand",
        "label": "Sand (alt sections)",
        "default": "#eadfcd"
      },
      {
        "type": "color",
        "id": "color_ember",
        "label": "Ember accent",
        "default": "#c2502e"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "select",
        "id": "heading_font_family",
        "label": "Display font",
        "options": [
          { "value": "'Fraunces', Georgia, serif", "label": "Fraunces" },
          { "value": "Georgia, serif", "label": "Georgia" }
        ],
        "default": "'Fraunces', Georgia, serif"
      },
      {
        "type": "select",
        "id": "body_font_family",
        "label": "Body font",
        "options": [
          {
            "value": "'Inter', system-ui, sans-serif",
            "label": "Inter"
          },
          { "value": "system-ui, sans-serif", "label": "System" }
        ],
        "default": "'Inter', system-ui, sans-serif"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1280
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "free_shipping_bar",
        "label": "Show free-shipping progress bar",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (in your currency, e.g. 150)",
        "default": 150
      }
    ]
  },
  {
    "name": "Social & SEO",
    "settings": [
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Default social share image",
        "info": "Used for link previews and as the Organization logo. 1200×630 recommended."
      }
    ]
  },
  {
    "name": "Analytics & CRO",
    "settings": [
      {
        "type": "header",
        "content": "Microsoft Clarity"
      },
      {
        "type": "paragraph",
        "content": "Free heatmaps + session recordings. Create a project at clarity.microsoft.com and paste the Project ID. Essential for CRO — see where users click, scroll, and rage-click."
      },
      {
        "type": "text",
        "id": "clarity_id",
        "label": "Clarity Project ID"
      },
      {
        "type": "header",
        "content": "Google Analytics 4"
      },
      {
        "type": "paragraph",
        "content": "Paste your GA4 Measurement ID (G-XXXXXXX). Shopify also has native GA — only add here if you want a second tag."
      },
      {
        "type": "text",
        "id": "ga4_id",
        "label": "GA4 Measurement ID"
      }
    ]
  }
]
